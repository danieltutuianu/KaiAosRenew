<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="WindowBgColor">#FFFFFFFF</Color>
  <Color x:Key="ContentBgColor">#FFF5F5F5</Color>
  <Color x:Key="FooterBgColor">#FFD4C4A8</Color>
  <Color x:Key="TextPrimaryColor">#FF282828</Color>
  <Color x:Key="TextMutedColor">#FF6E6E6E</Color>
  <Color x:Key="FieldBgColor">#FFFFFFFF</Color>
  <Color x:Key="ButtonTopColor">#FFF5F0E6</Color>
  <Color x:Key="ButtonBottomColor">#FFE8DFD0</Color>
  <Color x:Key="ButtonBorderColor">#FFAAA091</Color>
  <Color x:Key="FieldBorderColor">#FFC8C8C8</Color>
  <Color x:Key="StatusOkColor">#FF2E7D32</Color>
  <Color x:Key="StatusErrorColor">#FFC62828</Color>
  <Color x:Key="StatusStoppedColor">#FF8C8C8C</Color>
  <Color x:Key="StatusWarnColor">#FFB26A00</Color>
  <Color x:Key="WarnBannerBgColor">#FFF9E2A8</Color>
  <Color x:Key="WarnBannerFgColor">#FF5C4800</Color>
  <Color x:Key="PanelMutedBgColor">#FFF5F2EB</Color>
  <Color x:Key="ListSelectionColor">#FFCCE8FF</Color>
  <Color x:Key="ListHoverColor">#FFE8F4FC</Color>
  <Color x:Key="KeysNewVinHighlightColor">#FFF9C24A</Color>
  <Color x:Key="KeysNewVinBorderColor">#FFE0A020</Color>

  <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
  <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBgColor}" />
  <SolidColorBrush x:Key="FooterBgBrush" Color="{StaticResource FooterBgColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
