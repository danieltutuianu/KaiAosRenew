                            Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvFirebasePushSyncModeLabel" Text="Sync mode:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
