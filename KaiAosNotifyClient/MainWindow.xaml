                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="SrvFirebasePushGroup" Header="Firebase push (multi-site)" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <CheckBox x:Name="SrvFirebasePushEnableCheck" Content="Enable Firebase push (Realtime Database)"
