                    <TextBlock x:Name="SrvFirebasePushPollMinutesSuffix" Grid.Column="3" Text="min"
                               Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" Width="Auto" />
                  </Grid>
                  <StackPanel Grid.IsSharedSizeScope="True">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="FbLabel" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="SrvFirebasePushUrlLabel" Text="Database URL:" Style="{DynamicResource FieldLabel}"
                                 Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SrvFirebasePushUrlBox" Width="420" HorizontalAlignment="Left"
                                 Style="{DynamicResource KaiTextBox}"
                                 LostFocus="SrvSettingsField_LostFocus" TextChanged="SrvSettings_Changed" />
                        <Button x:Name="SrvFirebasePushUrlCopyBtn"
                                Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                                MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                                Content=""
                                Click="SrvFirebasePushUrlCopy_Click"
                                Tag="{DynamicResource IconCopy}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                        <Button x:Name="SrvFirebasePushUrlPasteBtn"
                                Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                                MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                                Content=""
                                Click="SrvFirebasePushUrlPaste_Click"
                                Tag="{DynamicResource IconPaste}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="FbLabel" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="SrvFirebasePushSecretLabel" Text="Shared secret:" Style="{DynamicResource FieldLabel}"
                                 Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="220" HorizontalAlignment="Left">
                          <PasswordBox x:Name="SrvFirebasePushSecretBox" Style="{DynamicResource KaiPasswordBox}"
                                       LostFocus="SrvSettingsField_LostFocus" PasswordChanged="SrvSettings_Changed" />
                          <TextBox x:Name="SrvFirebasePushSecretPlainBox" Style="{DynamicResource KaiTextBox}"
                                   Visibility="Collapsed"
                                   LostFocus="SrvSettingsField_LostFocus" TextChanged="SrvSettings_Changed" />
                        </Grid>
                        <CheckBox x:Name="SrvFirebasePushShowSecretCheck" Content="Show password" Style="{DynamicResource KaiCheckBox}"
                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                  Checked="SrvFirebasePushShowSecret_Changed" Unchecked="SrvFirebasePushShowSecret_Changed" />
                        <Button x:Name="SrvFirebasePushGenerateBtn"
                                Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                                MinWidth="80" Padding="8,2" VerticalAlignment="Center"
                                Content="Generate"
                                Click="SrvFirebasePushGenerate_Click" />
                        <Button x:Name="SrvFirebasePushCopyBtn"
                                Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                                MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                                Content=""
                                Click="SrvFirebasePushCopy_Click"
                                Tag="{DynamicResource IconCopy}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                        <Button x:Name="SrvFirebasePushSecretPasteBtn"
                                Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                                MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                                Content=""
                                Click="SrvFirebasePushSecretPaste_Click"
                                Tag="{DynamicResource IconPaste}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="FbLabel" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="SrvFirebasePushServerNameLabel" Text="This server name:" Style="{DynamicResource FieldLabel}"
                                 Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBox x:Name="SrvFirebasePushServerNameBox" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                               Style="{DynamicResource KaiTextBox}"
                               LostFocus="SrvSettingsField_LostFocus" TextChanged="SrvSettings_Changed" />
                    </Grid>
                  </StackPanel>
                  <WrapPanel Margin="0,4,0,4">
                    <Button x:Name="SrvFirebasePushNowBtn" Content="Sync now" Style="{DynamicResource BeigeButton}"
                            Margin="0,0,8,6" Padding="10,4" Click="SrvFirebasePushNow_Click"
                            Tag="{DynamicResource IconRefresh}" />
                    <Button x:Name="SrvFirebasePushPushBtn" Content="Push now" Style="{DynamicResource BeigeButton}"
                            Margin="0,0,8,6" Padding="10,4" Click="SrvFirebasePushPush_Click"
                            Tag="{DynamicResource IconUpdate}" />
                    <Button x:Name="SrvFirebasePushTestBtn" Content="Test connection" Style="{DynamicResource BeigeButton}"
                            Margin="0,0,8,6" Padding="10,4" Click="SrvFirebasePushTest_Click"
                            Tag="{DynamicResource IconInfo}" />
                  </WrapPanel>
                  <TextBlock x:Name="SrvFirebasePushStatusText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                             Foreground="{DynamicResource TextMutedBrush}" Text="" />
                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="SrvPathsGroup" Header="Paths" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <TextBlock x:Name="SrvPathsKaiConfig" Text="KAI configuration:" Style="{DynamicResource SectionText}" Margin="0,0,0,8" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvConfigPathLabel" Text="Config path:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <TextBox x:Name="SrvConfigPathBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                             IsReadOnly="True" IsEnabled="False" />
                  </Grid>
                  <TextBlock x:Name="SrvPathsKeyReader" Text="Desktop KeyReader Plus:" Style="{DynamicResource SectionText}" Margin="0,12,0,8" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvDataBinLabel" Text="DataBin:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <TextBox x:Name="SrvDataBinBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                             IsReadOnly="True" IsEnabled="False" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvKrLogPathLabel" Text="Log files location:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <TextBox x:Name="SrvKrLogPathBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                             IsReadOnly="True" IsEnabled="False" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvEncPathLabel" Text="ENC file location:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <TextBox x:Name="SrvEncPathBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}" IsReadOnly="True" IsEnabled="False" />
                  </Grid>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvKrLogLevelLabel" Text="Logging:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <ComboBox x:Name="SrvKrLogLevelCombo" Grid.Column="1" HorizontalAlignment="Left" Width="180"
                              Style="{DynamicResource KaiComboBox}"
                              DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectionChanged="SrvSettings_Changed" />
                  </Grid>
                  <TextBlock x:Name="SrvPathsKaiData" Text="KAI data paths:" Style="{DynamicResource SectionText}" Margin="0,0,0,8" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvUploaderLogLabel" Text="KeyUploader logs:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <TextBox x:Name="SrvUploaderLogBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}" IsReadOnly="True" IsEnabled="False" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvKaiLogLabel" Text="KAI logs:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <TextBox x:Name="SrvKaiLogBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}" IsReadOnly="True" IsEnabled="False" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvSqliteLabel" Text="SqliteKaiDb:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <TextBox x:Name="SrvSqliteBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                             IsReadOnly="True" IsEnabled="False" />
                  </Grid>
                </StackPanel>
              </GroupBox>
              <StackPanel Margin="0,8,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" HorizontalAlignment="Left">
                  <Button x:Name="SrvSettingsSaveBtn" Content="Save to server" Style="{DynamicResource BeigeButton}"
                          MinWidth="140" Margin="0,0,8,0" IsEnabled="False" Click="SrvSettingsSave_Click"  Tag="{DynamicResource IconSave}" />
                  <Button x:Name="SrvSettingsResetBtn" Content="Reset" Style="{DynamicResource BeigeButton}"
                          MinWidth="100" IsEnabled="False" Click="SrvSettingsReset_Click"  Tag="{DynamicResource IconRestart}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Ellipse x:Name="SrvSettingsPendingMark" Width="10" Height="10" Margin="0,0,6,0"
                           Fill="#B26A00" VerticalAlignment="Center" Visibility="Collapsed" />
                  <TextBlock x:Name="SrvSettingsOkMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                             FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"
                             Foreground="#2E7D32" Visibility="Collapsed" />
                  <TextBlock x:Name="SrvSettingsStatus" Text="" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabSettings" Header="Client Settings">
          <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Margin="4"
                        Background="{DynamicResource WindowBgBrush}">
            <StackPanel Background="{DynamicResource WindowBgBrush}">
              <GroupBox x:Name="ConnectionGroup" Header="Connection" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" MinWidth="36" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IpLabel" Text="IP:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{DynamicResource FieldLabel}"
                               Width="Auto" HorizontalAlignment="Left" />
                    <ComboBox x:Name="HostCombo" Grid.Column="1" Height="28" Width="220" Margin="0,0,8,0"
                              HorizontalAlignment="Left"
                              IsEditable="True" VerticalContentAlignment="Center"
                              Style="{DynamicResource KaiComboBox}"
                              TextSearch.TextPath="Host"
                              LostFocus="HostPort_LostFocus"
                              ToolTip="Notify server IP — use Scan LAN or pick a recent host">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="PortLabel" Grid.Column="2" Text="Port:" VerticalAlignment="Center"
                               Margin="0,0,8,0" Style="{DynamicResource FieldLabel}"
                               Width="Auto" HorizontalAlignment="Left" />
                    <TextBox x:Name="PortBox" Grid.Column="3" Width="72" Margin="0,0,8,0"
                             Style="{DynamicResource KaiTextBox}" Text="17890" LostFocus="HostPort_LostFocus" />
                    <Button x:Name="ScanLanBtn" Grid.Column="4" Content="Scan LAN"
                            Style="{DynamicResource BeigeButton}" Click="ScanLan_Click"
                            ToolTip="Scan local network for notify server"  Tag="{DynamicResource IconScan}" />
                    <Button x:Name="FavHostBtn" Grid.Column="5" Content="&#x2605;" Margin="8,0,0,0" MinWidth="36"
                            Style="{DynamicResource BeigeButton}" Click="FavHost_Click"
                            ToolTip="Save this host as a favorite (optional alias)" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PairingCodeLabel" Text="Pairing code:" VerticalAlignment="Center"
                               Margin="0,0,8,0" Style="{DynamicResource FieldLabel}"
                               Width="Auto" HorizontalAlignment="Left"
                               ToolTip="Must match the server pairing code when the server requires one" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBox x:Name="PairingCodeBox" Width="160" HorizontalAlignment="Left"
                               Style="{DynamicResource KaiTextBox}" LostFocus="HostPort_LostFocus"
                               ToolTip="Leave empty if the server has no pairing code" />
                      <Button x:Name="PairingCodePasteBtn"
                              Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                              MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                              Content=""
                              Click="PairingCodePaste_Click"
                              ToolTip="Paste pairing code"
                              Tag="{DynamicResource IconPaste}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Left">
                    <Button x:Name="ConnectBtn" Content="Connect" Style="{DynamicResource BeigeButton}"
                            MinWidth="100" Click="ConnectBtn_Click"  Tag="{DynamicResource IconConnect}" />
                    <Button x:Name="DisconnectBtn" Content="Disconnect" Style="{DynamicResource BeigeButton}"
                            MinWidth="100" IsEnabled="False" Click="DisconnectBtn_Click"  Tag="{DynamicResource IconDisconnect}" />
                  </StackPanel>
                  <CheckBox x:Name="AutoConnectCheck" Content="Auto-connect on start" Margin="0,0,0,8"
                            Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left"
                            Checked="AutoConnect_Changed" Unchecked="AutoConnect_Changed"
                            ToolTip="Connect automatically when the app starts" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OfflineAfterLabel" Text="Offline after (minutes):" VerticalAlignment="Center"
                               Margin="0,0,8,0" Style="{DynamicResource FieldLabel}"
                               Width="Auto" HorizontalAlignment="Left" />
                    <TextBox x:Name="OfflineMinutesBox" Grid.Column="1" Width="60"
                             Style="{DynamicResource KaiTextBox}" Text="2"
                             LostFocus="SettingsField_Changed" />
                  </Grid>
                </StackPanel>
              </GroupBox>

              <GroupBox x:Name="GeneralGroup" Header="General" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LanguageLabel" Text="Language:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" HorizontalAlignment="Left" />
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                              Style="{DynamicResource KaiComboBox}"
                              DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectionChanged="LanguageCombo_SelectionChanged" />
                    <TextBlock x:Name="ThemeLabel" Grid.Row="1" Text="Theme:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <ComboBox x:Name="ThemeCombo" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                              Margin="0,8,0,0" Style="{DynamicResource KaiComboBox}"
                              DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectionChanged="ThemeCombo_SelectionChanged" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="OpenSettingsFolderBtn" Content="Open settings folder" Style="{DynamicResource BeigeButton}"
                            HorizontalAlignment="Left" MinWidth="130" Margin="0,0,8,0"
                            Click="OpenSettingsFolder_Click"  Tag="{DynamicResource IconFolder}" />
                    <Button x:Name="OpenLogsFolderBtn" Content="Open logs folder" Style="{DynamicResource BeigeButton}"
                            HorizontalAlignment="Left" MinWidth="130"
                            Click="OpenLogsFolder_Click"  Tag="{DynamicResource IconFolder}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="ExportClientSettingsBtn" Content="Export settings" Style="{DynamicResource BeigeButton}"
                            Click="ExportClientSettings_Click" Margin="0,0,8,0" MinWidth="120"  Tag="{DynamicResource IconExport}" />
                    <Button x:Name="ImportClientSettingsBtn" Content="Import settings" Style="{DynamicResource BeigeButton}"
                            Click="ImportClientSettings_Click" MinWidth="120"  Tag="{DynamicResource IconImport}" />
                  </StackPanel>
                </StackPanel>
              </GroupBox>

              <GroupBox x:Name="StartupGroup" Header="Startup" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Margin="0,0,0,8"
                            Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left"
                            Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed" />
                  <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to tray on start" Margin="0,0,0,8"
                            Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left"
                            Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed" />
                  <CheckBox x:Name="MinimizeOnCloseCheck" Content="Yes (X hides to tray)" Margin="0,0,0,8"
                            Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left"
                            Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed" />
                  <CheckBox x:Name="AutoUpdateCheck" Content="Auto update" Margin="0,0,0,8"
                            Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left" IsChecked="True"
                            Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed" />
                  <Button x:Name="CheckForUpdatesBtn"
                          Content="Check for updates" Style="{DynamicResource BeigeButton}"
                          HorizontalAlignment="Left" Padding="10,4" Click="CheckForUpdates_Click"  Tag="{DynamicResource IconUpdate}" />
                </StackPanel>
              </GroupBox>

              <GroupBox x:Name="KeysSettingsGroup" Header="Keys" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <CheckBox x:Name="ShowVinTipsCheck" Content="Info tip when VIN is read" Margin="0,0,0,6"
                            Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left"
                            Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed" />
                  <CheckBox x:Name="ShowVinTipsBmwFailOnlyCheck"
                            Content="and only when upload to BMW server fails"
                            Margin="18,0,0,6" Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left"
                            Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed" />
                  <CheckBox x:Name="AutoCopyVinCheck" Content="Auto-copy VIN when read" Margin="18,0,0,6"
                            Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left"
                            Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed" />
                  <StackPanel Orientation="Horizontal" Margin="18,0,0,8" VerticalAlignment="Center">
                    <TextBox x:Name="VinTipSecondsBox" Width="40"
                             Style="{DynamicResource KaiTextBox}" Text="10" Margin="0,0,8,0"
                             LostFocus="SettingsField_Changed"
                             ToolTip="3–60 sec, or 0 = until Copy VIN / Close / next VIN tip" />
                    <TextBlock x:Name="VinTipDurationLabel" Text="VIN tip duration (sec, 0 = sticky):"
                               Style="{DynamicResource FieldLabel}" Width="Auto" TextWrapping="Wrap"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />
                  </StackPanel>
                  <CheckBox x:Name="ShowAlertTipsCheck" Content="Show warning/error alerts (stall / BMW upload)"
                            Margin="0,0,0,8" Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left"
                            Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed" />
                  <Button x:Name="TestBalloonTipsBtn" Content="Test balloon tips" Style="{DynamicResource BeigeButton}"
                          HorizontalAlignment="Left" MinWidth="140"
                          Click="TestBalloonTipsBtn_Click"  Tag="{DynamicResource IconInfo}" />
                </StackPanel>
              </GroupBox>

              <GroupBox x:Name="AuthGroup" Header="Auth" Style="{DynamicResource KaiGroupBox}">
                <CheckBox x:Name="BrowserPassHintCheck"
                          Content="On auth failure, remind to match browser password"
                          Style="{DynamicResource KaiCheckBox}" HorizontalAlignment="Left"
                          Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed" />
              </GroupBox>

            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <Border x:Name="AboutPanel" Visibility="Collapsed" Background="{DynamicResource WindowBgBrush}"
              BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Margin="0,30,0,0"
              Panel.ZIndex="1">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="AboutTitleText" Text="KAI - AOS Renew - Client" Style="{DynamicResource SectionText}"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="AboutVersionText" Text="" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"
                       Cursor="Hand" MouseLeftButtonDown="AboutVersionText_MouseLeftButtonDown" />
            <TextBlock x:Name="AboutChangelogLabel" Text="CHANGELOG.md" Style="{DynamicResource SectionText}"
                       Margin="0,8,0,6" />
          </StackPanel>
          <TextBox x:Name="AboutChangelogBox" Grid.Row="1"
                   IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"
                   Style="{DynamicResource KaiTextBox}"
                   VerticalAlignment="Stretch" MinHeight="280" />
        </Grid>
      </Border>

      <Button x:Name="AboutTabBtn" Content="About" Style="{DynamicResource AboutTabButton}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,2,0,0" MinWidth="72" Panel.ZIndex="2"
              Click="AboutTabBtn_Click"  />
      </Grid>

      <Border x:Name="ButtonsBorder" Grid.Row="2" Background="{DynamicResource WindowBgBrush}"
              Padding="0" Visibility="Collapsed" Height="0" />

      <TextBlock x:Name="ConnStatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
    </Grid>

    <Border x:Name="FooterBar" Grid.Row="1" Background="{DynamicResource FooterBgBrush}" Height="46" Padding="14,2,14,2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="22" />
          <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource StatusStoppedBrush}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource StatusStoppedBrush}" Margin="0,0,12,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <TextBlock x:Name="NextRunText" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock x:Name="RttText" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TokenAgeText" Text=""
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock x:Name="TokenFooterText" Text=""
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="ServicesFooterText" Text=""
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
          <TextBlock x:Name="RegisterAgeText"
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Left" Text="" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="VersionText" Text="Client version: 1.0"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="UpdateAvailableText" Text=""
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
            <ProgressBar x:Name="UpdateProgressBar" Width="110" Height="10" Minimum="0" Maximum="100"
                         VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
            <Button x:Name="FooterUpdateBtn" Content="Update" Style="{DynamicResource FooterUpdateButton}"
                    VerticalAlignment="Center" Visibility="Collapsed" Click="FooterUpdate_Click"  Tag="{DynamicResource IconUpdate}" />
            <TextBlock x:Name="ServerUpdateAvailableText" Text=""
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
            <Button x:Name="FooterServerUpdateBtn" Content="Update server" Style="{DynamicResource FooterUpdateButton}"
                    VerticalAlignment="Center" Visibility="Collapsed" Click="FooterServerUpdate_Click"  Tag="{DynamicResource IconUpdate}" />
          </StackPanel>
          <TextBlock x:Name="AuthGuardsFooterText"
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Right" Text=""
                     TextTrimming="CharacterEllipsis" MaxWidth="420" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>

