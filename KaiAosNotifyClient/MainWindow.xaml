<Window x:Class="KaiAosNotifyClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAI - AOS Renew - Client"
        Width="1280" Height="740"
        MinWidth="1040" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource KaiFont}"
        Background="{DynamicResource WindowBgBrush}"
        FocusVisualStyle="{DynamicResource KaiFocusVisual}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TitleText" Grid.Column="0" Text="KAI - AOS Renew - Client"
                   Style="{DynamicResource TitleText}" VerticalAlignment="Bottom" />
        <TextBlock x:Name="DebugModeText" Grid.Column="1" Text="" Margin="12,0,0,3" FontSize="13"
                   FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorBrush}"
                   Cursor="Hand" VerticalAlignment="Bottom" Visibility="Collapsed"
                   MouseLeftButtonDown="DebugModeText_MouseLeftButtonDown" />
      </Grid>

      <Grid x:Name="MainContentHost" Grid.Row="1" Margin="0,12,0,0">
      <TabControl x:Name="MainTabs" Background="{DynamicResource WindowBgBrush}"
                  BorderBrush="{DynamicResource FieldBorderBrush}">
        <TabItem x:Name="TabDummy" Visibility="Collapsed" Header="">
          <Border />
        </TabItem>
        <TabItem x:Name="TabKeys">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="TabKeysHeaderText" Text="Keys" VerticalAlignment="Center" />
              <TextBlock x:Name="KeysTodayBadge" Text="" Margin="6,0,0,0" VerticalAlignment="Center"
                         FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <Ellipse x:Name="KeysTabAlertDot" Width="10" Height="10" Margin="8,0,0,0"
                       Fill="#FFE53935" VerticalAlignment="Center" Visibility="Collapsed"
                       Cursor="Hand" MouseLeftButtonDown="KeysTabAlertDot_Click" />
            </StackPanel>
          </TabItem.Header>
          <Grid Margin="4" Background="{DynamicResource WindowBgBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Button x:Name="KeysRefreshBtn" Content="Refresh" Style="{DynamicResource BeigeButton}"
                      Click="KeysRefresh_Click" MinWidth="90" Margin="0,0,8,4"  Tag="{DynamicResource IconRefresh}" />
              <Button x:Name="KeysClearBtn" Content="Clear" Style="{DynamicResource BeigeButton}"
                      Click="KeysClear_Click" MinWidth="80" Margin="0,0,8,4"  Tag="{DynamicResource IconClear}" />
              <Button x:Name="KeysExportBtn" Content="Export" Style="{DynamicResource BeigeButton}"
                      Click="KeysExport_Click" MinWidth="80" Margin="0,0,8,4" IsEnabled="False"
                      ToolTip="Export the visible Keys rows to CSV or TXT"  Tag="{DynamicResource IconSave}" />
              <Button x:Name="KeysRetryBmwBtn" Content="Retry BMW" Style="{DynamicResource BeigeButton}"
                      Click="KeysRetryBmw_Click" MinWidth="100" Margin="0,0,8,4"
                      IsEnabled="False"
                      ToolTip="Ask the server to re-send the last key file to BMW Server"  Tag="{DynamicResource IconRetry}" />
              <TextBlock x:Name="KeysFilterLabel" Text="Filter:" VerticalAlignment="Center" Margin="8,0,6,4"
                         Style="{DynamicResource FieldLabel}" />
              <ComboBox x:Name="KeysFilterCombo" Width="120" VerticalAlignment="Center" Margin="0,0,0,4"
                        Style="{DynamicResource KaiComboBox}"
                        SelectionChanged="KeysFilter_SelectionChanged" />
              <TextBlock x:Name="KeysSearchLabel" Text="Search:" VerticalAlignment="Center" Margin="10,0,6,4"
                         Style="{DynamicResource FieldLabel}" />
              <TextBox x:Name="KeysSearchBox" Width="140" VerticalAlignment="Center" Margin="0,0,0,4"
                       Style="{DynamicResource KaiTextBox}"
                       ToolTip="VIN / paint / I-level"
                       TextChanged="KeysSearchBox_TextChanged" />
              <Button x:Name="KeysSearchClearBtn" Content="✕" Style="{DynamicResource BeigeButton}"
                      Click="KeysSearchClear_Click" MinWidth="28" Padding="8,4,8,4" Margin="6,0,0,4"
                      HorizontalContentAlignment="Center" Visibility="Collapsed"
                      ToolTip="Clear search"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            </WrapPanel>
            <StackPanel Grid.Row="1">
              <Border x:Name="KeysReaderWarnBanner" Background="{DynamicResource WarnBannerBgBrush}"
                      BorderBrush="{DynamicResource StatusWarnBrush}"
                      BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8"
                      Visibility="Collapsed">
                <TextBlock x:Name="KeysReaderWarnText" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" FontWeight="SemiBold" />
              </Border>
              <TextBlock x:Name="KeysEventsSection" Text="Recent key activity:" Margin="0,0,0,4"
                         Style="{DynamicResource SectionText}" />
              <TextBlock x:Name="KeysEmptyHint" Text="No key activity yet"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Margin="0,0,0,4" Visibility="Collapsed" />
              <TextBlock x:Name="KeysNoMatchesHint" Text="No matches — clear filter"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Margin="0,0,0,4" Visibility="Collapsed" />
            </StackPanel>
            <ListView x:Name="KeysEventsList" Grid.Row="2"
                      BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                      Background="{DynamicResource FieldBgBrush}" FontSize="12"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      PreviewKeyDown="KeysEventsList_PreviewKeyDown">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource KaiListViewItem}">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                  <Setter Property="ToolTip" Value="{Binding RowToolTip}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="BmwOk">
                      <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                      <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="LocalOk">
                      <Setter Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Waiting">
                      <Setter Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="KeysColIndex" Header="#" Width="40"
                                  DisplayMemberBinding="{Binding Index}" />
                  <GridViewColumn x:Name="KeysColTime" Header="Time" Width="120"
                                  DisplayMemberBinding="{Binding TimeText}" />
                  <GridViewColumn x:Name="KeysColVin" Header="VIN" Width="175">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Button Padding="0" Margin="0,0,4,0" Width="18" Height="18"
                                  FontFamily="Segoe MDL2 Assets" FontSize="11" Content="&#xE8C8;"
                                  Cursor="Hand" Focusable="True" IsTabStop="False"
                                  Style="{DynamicResource KeysActionIconButton}"
                                  AutomationProperties.Name="Copy VIN"
                                  Loaded="KeysVinCopyIcon_Loaded"
                                  DataContextChanged="KeysVinCopyIcon_DataContextChanged"
                                  PreviewMouseLeftButtonDown="KeysVinCopyIcon_PreviewMouseLeftButtonDown"
                                  Click="KeysVinCopyIcon_Click">
                            <Button.ToolTip>
                              <ToolTip Foreground="Black" Background="#FFF7F7F7" BorderBrush="#FFABABAB" BorderThickness="1"
                                       Padding="6,4">
                                <TextBlock Text="Copy VIN" Foreground="Black" />
                              </ToolTip>
                            </Button.ToolTip>
                          </Button>
                          <TextBlock Tag="vin" VerticalAlignment="Center"
                                     Loaded="KeysHighlightCell_Loaded"
                                     DataContextChanged="KeysHighlightCell_DataContextChanged" />
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="KeysColKm" Header="Km" Width="95">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Button Padding="0" Margin="0,0,4,0" Width="18" Height="18"
                                  FontFamily="Segoe MDL2 Assets" FontSize="11" Content="&#xE8C8;"
                                  Cursor="Hand" Focusable="True" IsTabStop="False"
                                  Style="{DynamicResource KeysActionIconButton}"
                                  AutomationProperties.Name="Copy Km"
                                  Loaded="KeysKmCopyIcon_Loaded"
                                  DataContextChanged="KeysKmCopyIcon_DataContextChanged"
                                  PreviewMouseLeftButtonDown="KeysKmCopyIcon_PreviewMouseLeftButtonDown"
                                  Click="KeysKmCopyIcon_Click">
                            <Button.ToolTip>
                              <ToolTip Foreground="Black" Background="#FFF7F7F7" BorderBrush="#FFABABAB" BorderThickness="1"
                                       Padding="6,4">
                                <TextBlock Text="Copy Km" Foreground="Black" />
                              </ToolTip>
                            </Button.ToolTip>
                          </Button>
                          <TextBlock Text="{Binding KmText}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="KeysColPaint" Header="Color" Width="60"
                                  DisplayMemberBinding="{Binding PaintText}" />
                  <GridViewColumn x:Name="KeysColUpholstery" Header="Upholstery" Width="95"
                                  DisplayMemberBinding="{Binding UpholsteryText}" />
                  <GridViewColumn x:Name="KeysColILevel" Header="I-level" Width="130">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Tag="ilevel"
                                   Loaded="KeysHighlightCell_Loaded"
                                   DataContextChanged="KeysHighlightCell_DataContextChanged" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="KeysColReader" Header="Reader" Width="100"
                                  DisplayMemberBinding="{Binding ReaderId}" />
                  <GridViewColumn x:Name="KeysColLocal" Header="Local" Width="50"
                                  DisplayMemberBinding="{Binding LocalText}" />
                  <GridViewColumn x:Name="KeysColBmw" Header="BMW Server" Width="85"
                                  DisplayMemberBinding="{Binding BmwText}" />
                  <GridViewColumn x:Name="KeysColDetail" Header="Detail" Width="220"
                                  DisplayMemberBinding="{Binding DetailText}" />
                  <GridViewColumn x:Name="KeysColBin" Header="Bin" Width="0">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button Width="20" Height="20" Padding="3" Margin="0"
                                MinWidth="20" MinHeight="20"
                                Style="{DynamicResource KeysActionIconButton}"
                              Background="{DynamicResource ButtonTopBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                VerticalAlignment="Center" Cursor="Hand" Focusable="True" IsTabStop="False"
                              AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                Loaded="KeysDownloadBinBtn_Loaded"
                                DataContextChanged="KeysDownloadBinBtn_DataContextChanged"
                                Click="KeysDownloadBinBtn_Click"
                                ToolTip="Download keyreader.bin from server">
                          <Viewbox Width="12" Height="12">
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{DynamicResource IconExport}" Stretch="Uniform" />
                          </Viewbox>
                        </Button>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="KeysColBinPad" Header="" Width="0">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Border />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </TabItem>

        <TabItem x:Name="TabAos">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="TabAosHeaderText" Text="AOS access" VerticalAlignment="Center" />
              <Ellipse x:Name="RenewTabAlertDot" Width="10" Height="10" Margin="8,0,0,0"
                       Fill="#FFE53935" VerticalAlignment="Center" Visibility="Collapsed"
                       Cursor="Hand" MouseLeftButtonDown="RenewTabAlertDot_Click" />
            </StackPanel>
          </TabItem.Header>
          <Grid Margin="4" Background="{DynamicResource WindowBgBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" MinHeight="48" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="24" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" HorizontalAlignment="Center" Width="480" MaxWidth="520" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="AosLoginStatusIcon" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           VerticalAlignment="Center" Margin="0,0,10,0" Text="" />
                <TextBlock x:Name="AosLoginStatusText" Text="" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="480" MaxWidth="520">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AosUserLabel" Style="{DynamicResource FieldLabel}" Text="AOS username:" VerticalAlignment="Center" />
                <TextBox x:Name="AosEmailBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                         TextChanged="AosField_TextChanged" />
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AosPassLabel" Style="{DynamicResource FieldLabel}" Text="AOS password:" VerticalAlignment="Center" />
                <Grid Grid.Column="1">
                  <PasswordBox x:Name="AosPasswordBox" Style="{DynamicResource KaiPasswordBox}"
                               PasswordChanged="AosPassword_Changed" />
                  <TextBox x:Name="AosPasswordPlainBox" Style="{DynamicResource KaiTextBox}"
                           Visibility="Collapsed" TextChanged="AosField_TextChanged" />
                </Grid>
              </Grid>
              <CheckBox x:Name="AosShowPasswordCheck" Content="Show password" Margin="130,0,0,8"
                        Style="{DynamicResource KaiCheckBox}"
                        Checked="AosShowPassword_Changed" Unchecked="AosShowPassword_Changed" />
              <Border x:Name="ClipboardPassBanner" Background="{DynamicResource WarnBannerBgBrush}"
                      BorderBrush="{DynamicResource StatusWarnBrush}"
                      BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="130,0,0,8"
                      Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="ClipboardPassHeaderText" TextWrapping="Wrap"
                             Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <TextBlock x:Name="ClipboardPassCurrentText" TextWrapping="Wrap"
                             Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" Margin="0,0,0,2" />
                  <TextBlock x:Name="ClipboardPassClipText" TextWrapping="Wrap"
                             Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" Margin="0,0,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="ClipboardPassPasteSaveBtn" Content="Paste &amp; Save" Style="{DynamicResource BeigeButton}"
                            Click="ClipboardPassPasteSave_Click" MinWidth="100" Margin="0,0,8,0" Tag="{DynamicResource IconPaste}" />
                    <Button x:Name="ClipboardPassDismissBtn" Content="Dismiss" Style="{DynamicResource BeigeButton}"
                            Click="ClipboardPassDismiss_Click" MinWidth="80" Tag="{DynamicResource IconDismiss}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="BrowserPassNewerBanner" Background="{DynamicResource WarnBannerBgBrush}"
                      BorderBrush="{DynamicResource StatusWarnBrush}"
                      BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="130,0,0,8"
                      Visibility="Collapsed">
                <TextBlock x:Name="BrowserPassNewerText" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" />
              </Border>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                  <Button x:Name="AosSaveBtn" Style="{DynamicResource BeigeButton}"
                          MinWidth="90" HorizontalAlignment="Center" Click="AosSave_Click" Padding="12,4">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Fill="{DynamicResource TextPrimaryBrush}"
                              Data="{DynamicResource AosIconSaveGeometry}" />
                      </Viewbox>
                      <TextBlock x:Name="AosSaveBtnText" Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Ellipse x:Name="AosDirtyPendingMark" Width="10" Height="10" Margin="0,0,6,0"
                             Fill="#B26A00" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="AosDirtyStatus" Text="" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
              <WrapPanel Margin="0,36,0,8" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AosPullCloudBtn" Style="{DynamicResource BeigeButton}"
                        MinWidth="140" Margin="0,0,8,8" Padding="10,4"
                        Click="AosPullCloud_Click" ToolTipService.ShowOnDisabled="True">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                      <Path Fill="{DynamicResource TextPrimaryBrush}"
                            Data="{DynamicResource AosIconCloudGeometry}" />
                    </Viewbox>
                    <TextBlock x:Name="AosPullCloudBtnText" Text="Pull from cloud" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="AosCheckBrowserPassBtn" Style="{DynamicResource BeigeButton}"
                        MinWidth="140" Margin="0,0,8,8" Padding="10,4"
                        Click="AosCheckBrowserPass_Click">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                      <Path Fill="{DynamicResource TextPrimaryBrush}"
                            Data="{DynamicResource AosIconSearchGeometry}" />
                    </Viewbox>
                    <TextBlock x:Name="AosCheckBrowserPassBtnText" Text="Check browser password" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="AosOpenBmwBtn" Style="{DynamicResource BeigeButton}"
                        MinWidth="120" Margin="0,0,0,8" Padding="10,4" Click="AosOpenBmw_Click">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                      <Path Fill="{DynamicResource TextPrimaryBrush}"
                            Data="{DynamicResource AosIconOpenGeometry}" />
                    </Viewbox>
                    <TextBlock x:Name="AosOpenBmwBtnText" Text="Open BMW AOS" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem x:Name="TabActivity">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="TabActivityHeaderText" Text="Activity" VerticalAlignment="Center" />
              <Ellipse x:Name="ActivityTabAlertDot" Width="10" Height="10" Margin="8,0,0,0"
                       Fill="#FFE53935" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
          </TabItem.Header>
          <Grid Margin="4" Background="{DynamicResource WindowBgBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4" LastChildFill="False">
              <TextBlock x:Name="ActivitySection" Text="Server activity log:"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <WrapPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="ActivityFilterLabel" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,4"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <ComboBox x:Name="LogFilterCombo" Width="120" Margin="0,0,10,4" VerticalAlignment="Center"
                          Style="{DynamicResource KaiComboBox}"
                          DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectionChanged="LogFilter_SelectionChanged" />
                <TextBlock x:Name="ActivitySearchLabel" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,4"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <TextBox x:Name="ActivitySearchBox" Width="140" Margin="0,0,6,4" VerticalAlignment="Center"
                         Style="{DynamicResource KaiTextBox}"
                         ToolTip="Message text"
                         TextChanged="ActivitySearchBox_TextChanged" />
                <Button x:Name="ActivitySearchClearBtn" Content="✕" Style="{DynamicResource BeigeButton}"
                        Click="ActivitySearchClear_Click" MinWidth="28" Padding="8,4,8,4" Margin="0,0,10,4"
                        HorizontalContentAlignment="Center" Visibility="Collapsed"
                        ToolTip="Clear search" />
                <Button x:Name="AosCheckTokenBtn" Content="Check token" Style="{DynamicResource BeigeButton}"
                        MinWidth="110" Margin="0,0,8,4" Padding="10,2,12,2" VerticalAlignment="Center"
                        Click="AosCheckToken_Click"  Tag="{DynamicResource IconCheck}" />
                <Button x:Name="ActivityRefreshBtn" Content="Refresh" Style="{DynamicResource BeigeButton}"
                        MinWidth="88" Margin="0,0,8,4" Padding="10,2,12,2" VerticalAlignment="Center"
                        Click="ActivityRefresh_Click"  Tag="{DynamicResource IconRefresh}" />
                <Button x:Name="SaveActivityLogBtn" Content="Save log" Style="{DynamicResource BeigeButton}"
                        MinWidth="88" Margin="0,0,8,4" Padding="10,2,12,2" VerticalAlignment="Center"
                        Click="SaveActivityLog_Click"  Tag="{DynamicResource IconSave}" />
                <Button x:Name="ActivityClearBtn" Content="Clear" Style="{DynamicResource BeigeButton}"
                        MinWidth="72" Margin="0,0,0,4" Padding="10,2,12,2" VerticalAlignment="Center"
                        Click="ActivityClear_Click"  Tag="{DynamicResource IconClear}" />
              </WrapPanel>
            </DockPanel>
            <StackPanel Grid.Row="1">
              <TextBlock x:Name="ActivityEmptyHint" Text="No activity yet"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Margin="0,0,0,4" Visibility="Collapsed" />
              <TextBlock x:Name="ActivityLoadingHint" Text="Loading…"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Margin="0,0,0,4" Visibility="Collapsed" />
              <TextBlock x:Name="ActivityNoMatchesHint" Text="No matches — clear filter"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Margin="0,0,0,4" Visibility="Collapsed" />
            </StackPanel>
            <ListView x:Name="ActivityList" Grid.Row="2"
                      BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                      Background="{DynamicResource FieldBgBrush}" FontFamily="Consolas" FontSize="11"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MouseDoubleClick="ActivityList_MouseDoubleClick"
                      PreviewKeyDown="ActivityList_PreviewKeyDown">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource KaiListViewItem}">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Level}" Value="success">
                      <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="warning">
                      <Setter Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="error">
                      <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="ActivityColTime" Header="Time" Width="120"
                                  DisplayMemberBinding="{Binding TimeText}" />
                  <GridViewColumn x:Name="ActivityColLevel" Header="Level" Width="70"
                                  DisplayMemberBinding="{Binding LevelText}" />
                  <GridViewColumn x:Name="ActivityColText" Header="Message" Width="900"
                                  DisplayMemberBinding="{Binding Text}" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </TabItem>

        <TabItem x:Name="TabRegister">
          <TabItem.Header>
            <TextBlock x:Name="TabRegisterHeaderText" Text="Register" VerticalAlignment="Center" />
          </TabItem.Header>
          <Grid Margin="4" Background="{DynamicResource WindowBgBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4" LastChildFill="False">
              <TextBlock x:Name="RegisterHistoryLabel" Text="Register history:"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <WrapPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="RegisterFilterLabel" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,4"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <ComboBox x:Name="RegisterFilterCombo" Width="120" Margin="0,0,10,4" VerticalAlignment="Center"
                          Style="{DynamicResource KaiComboBox}"
                          DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectionChanged="RegisterFilter_SelectionChanged" />
                <TextBlock x:Name="RegisterSearchLabel" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,4"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                <TextBox x:Name="RegisterSearchBox" Width="140" Margin="0,0,6,4" VerticalAlignment="Center"
                         Style="{DynamicResource KaiTextBox}"
                         ToolTip="Message text"
                         TextChanged="RegisterSearchBox_TextChanged" />
                <Button x:Name="RegisterSearchClearBtn" Content="✕" Style="{DynamicResource BeigeButton}"
                        Click="RegisterSearchClear_Click" MinWidth="28" Padding="8,4,8,4" Margin="0,0,10,4"
                        HorizontalContentAlignment="Center" Visibility="Collapsed"
                        ToolTip="Clear search" />
                <Button x:Name="RegisterRefreshBtn" Content="Refresh" Style="{DynamicResource BeigeButton}"
                        MinWidth="88" Margin="0,0,8,4" Padding="10,2,12,2" VerticalAlignment="Center"
                        Click="RegisterRefresh_Click"  Tag="{DynamicResource IconRefresh}" />
                <Button x:Name="SaveRegisterLogBtn" Content="Save log" Style="{DynamicResource BeigeButton}"
                        MinWidth="88" Margin="0,0,8,4" Padding="10,2,12,2" VerticalAlignment="Center"
                        Click="SaveRegisterLog_Click"  Tag="{DynamicResource IconSave}" />
                <Button x:Name="ClearRegisterLogBtn" Content="Clear" Style="{DynamicResource BeigeButton}"
                        MinWidth="72" Margin="0,0,0,4" Padding="10,2,12,2" VerticalAlignment="Center"
                        Click="ClearRegisterLog_Click"  Tag="{DynamicResource IconClear}" />
              </WrapPanel>
            </DockPanel>
            <StackPanel Grid.Row="1">
              <TextBlock x:Name="RegisterLoadingHint" Text="Loading…"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Margin="0,0,0,4" Visibility="Collapsed" />
              <TextBlock x:Name="RegisterEmptyHint" Text="No Register attempts yet"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Margin="0,0,0,4" Visibility="Collapsed" />
              <TextBlock x:Name="RegisterNoMatchesHint" Text="No matches — clear filter"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                         Margin="0,0,0,4" Visibility="Collapsed" />
            </StackPanel>
            <ListView x:Name="RegisterHistoryList" Grid.Row="2"
                      BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                      Background="{DynamicResource FieldBgBrush}" FontFamily="Consolas" FontSize="11"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MouseDoubleClick="RegisterHistoryList_MouseDoubleClick"
                      PreviewKeyDown="RegisterHistoryList_PreviewKeyDown">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource KaiListViewItem}">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="1">
                      <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="0">
                      <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="RegisterColTime" Header="Time" Width="140"
                                  DisplayMemberBinding="{Binding TimeText}" />
                  <GridViewColumn x:Name="RegisterColResult" Header="Result" Width="70"
                                  DisplayMemberBinding="{Binding ResultText}" />
                  <GridViewColumn x:Name="RegisterColAge" Header="Age" Width="110"
                                  DisplayMemberBinding="{Binding AgeText}" />
                  <GridViewColumn x:Name="RegisterColDetail" Header="Detail" Width="520"
                                  DisplayMemberBinding="{Binding Text}" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </TabItem>

        <TabItem x:Name="TabKai">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="TabKaiHeaderText" Text="KAI" VerticalAlignment="Center" />
              <Ellipse x:Name="KaiTabAlertDot" Width="10" Height="10" Margin="8,0,0,0"
                       Fill="#FFE53935" VerticalAlignment="Center" Visibility="Collapsed"
                       Cursor="Hand" MouseLeftButtonDown="KaiTabAlertDot_Click" />
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4"
                        Background="{DynamicResource WindowBgBrush}">
            <StackPanel Background="{DynamicResource WindowBgBrush}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="KaiRefreshBtn" Content="Refresh" Style="{DynamicResource BeigeButton}"
                        Click="KaiRefresh_Click" MinWidth="90"  Tag="{DynamicResource IconRefresh}" />
              </StackPanel>
              <TextBlock x:Name="KaiInstallSection" Text="Installation:" Style="{DynamicResource SectionText}" Margin="0,0,0,6" />
              <TextBlock x:Name="KaiInstallText" Text="—" TextWrapping="Wrap" Margin="0,0,0,12"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
              <TextBlock x:Name="KaiUrlsSection" Text="Kai Zentral URLs:" Style="{DynamicResource SectionText}" Margin="0,0,0,6" />
              <TextBlock x:Name="KaiUrlRegisterLabel" Text="Register:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox x:Name="KaiUrlRegisterBox" IsReadOnly="True" Style="{DynamicResource KaiTextBox}" Margin="0,2,0,6" TextWrapping="Wrap" />
              <TextBlock x:Name="KaiUrlWebEamLabel" Text="WebEAM:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox x:Name="KaiUrlWebEamBox" IsReadOnly="True" Style="{DynamicResource KaiTextBox}" Margin="0,2,0,6" TextWrapping="Wrap" />
              <TextBlock x:Name="KaiUrlUploadLabel" Text="Key upload:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBox x:Name="KaiUrlUploadBox" IsReadOnly="True" Style="{DynamicResource KaiTextBox}" Margin="0,2,0,12" TextWrapping="Wrap" />
              <TextBlock x:Name="KaiTokenSection" Text="WebEAM token:" Style="{DynamicResource SectionText}" Margin="0,0,0,6" />
              <TextBlock x:Name="KaiTokenExpiryText" Text="—" TextWrapping="Wrap" Margin="0,0,0,12"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
              <DockPanel Margin="0,0,0,6" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <Button x:Name="KaiFixServicesBtn" Content="Fix now" Style="{DynamicResource BeigeButton}"
                          Click="KaiFixServices_Click" MinWidth="90" Margin="0,0,8,0"
                          Visibility="Collapsed"  Tag="{DynamicResource IconFix}" />
                  <Button x:Name="KaiStopServicesBtn" Content="Restart" Style="{DynamicResource BeigeButton}"
                          Click="KaiStopServices_Click" MinWidth="90"
                          Visibility="Collapsed"  Tag="{DynamicResource IconRestart}" />
                </StackPanel>
                <TextBlock x:Name="KaiServicesSection" Text="Services:" Style="{DynamicResource SectionText}"
                           Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <Grid x:Name="KaiServicesGrid" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="220" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="KaiSvcColName" Grid.Row="0" Grid.Column="0" Text="Service" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,4" />
                <TextBlock x:Name="KaiSvcColStatus" Grid.Row="0" Grid.Column="1" Text="Status" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,4" />
                <TextBlock x:Name="KaiSvcColStart" Grid.Row="0" Grid.Column="2" Text="Start type" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                <TextBlock x:Name="KaiSvc1Name" Grid.Row="1" Grid.Column="0" Text="—" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,4" TextWrapping="Wrap" />
                <TextBlock x:Name="KaiSvc1Status" Grid.Row="1" Grid.Column="1" Text="—" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,4" />
                <TextBlock x:Name="KaiSvc1Start" Grid.Row="1" Grid.Column="2" Text="—" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock x:Name="KaiSvc2Name" Grid.Row="2" Grid.Column="0" Text="—" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" TextWrapping="Wrap" />
                <TextBlock x:Name="KaiSvc2Status" Grid.Row="2" Grid.Column="1" Text="—" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="KaiSvc2Start" Grid.Row="2" Grid.Column="2" Text="—" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabServerSettings">
          <TabItem.Header>
            <TextBlock x:Name="TabServerSettingsHeaderText" Text="Server Settings" VerticalAlignment="Center" />
          </TabItem.Header>
          <ScrollViewer x:Name="ServerSettingsScroll" VerticalScrollBarVisibility="Auto" Margin="4"
                        Background="{DynamicResource WindowBgBrush}">
            <StackPanel Background="{DynamicResource WindowBgBrush}">
              <GroupBox x:Name="SrvGeneralGroup" Header="General" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvLanguageLabel" Text="Language:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <ComboBox x:Name="SrvLanguageCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                              Style="{DynamicResource KaiComboBox}" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectionChanged="SrvSettings_Changed" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvThemeLabel" Text="Theme:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <ComboBox x:Name="SrvThemeCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                              Style="{DynamicResource KaiComboBox}" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectionChanged="SrvSettings_Changed" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="SrvDownloadSettingsFolderBtn" Content="Download settings folder" Style="{DynamicResource BeigeButton}"
                            MinWidth="160" Margin="0,0,8,0" Click="SrvDownloadSettingsFolder_Click" Tag="{DynamicResource IconFolder}" />
                    <Button x:Name="SrvDownloadLogsFolderBtn" Content="Download logs folder" Style="{DynamicResource BeigeButton}"
                            MinWidth="150" Margin="0,0,8,0" Click="SrvDownloadLogsFolder_Click" Tag="{DynamicResource IconFolder}" />
                    <Button x:Name="SrvDownloadDiagBundleBtn" Content="Diagnostic bundle" Style="{DynamicResource BeigeButton}"
                            MinWidth="140" Margin="0,0,8,0" Click="SrvDownloadDiagBundle_Click"
                            ToolTip="Download a zip with redacted server settings, recent logs, and service status"
                            Tag="{DynamicResource IconExport}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="SrvExportBtn" Content="Export settings" Style="{DynamicResource BeigeButton}"
                            Click="SrvExport_Click" Margin="0,0,8,0" MinWidth="120"  Tag="{DynamicResource IconExport}" />
                    <Button x:Name="SrvImportBtn" Content="Import settings" Style="{DynamicResource BeigeButton}"
                            Click="SrvImport_Click" MinWidth="120"  Tag="{DynamicResource IconImport}" />
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="SrvStartupGroup" Header="Startup" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <CheckBox x:Name="SrvStartWithWindowsCheck" Content="Start with Windows"
                            Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                            Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <CheckBox x:Name="SrvMinimizeToTrayCheck" Content="Minimize to tray on Windows start"
                            Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                            Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <CheckBox x:Name="SrvMinimizeOnCloseCheck" Content="Yes (X hides to tray)"
                            Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                            Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <CheckBox x:Name="SrvAutoUpdateCheck" Content="Auto update"
                            Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                            Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="SrvKeysGroup" Header="Keys" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvKeysRefreshLabel" Text="Refresh interval (sec):" Style="{DynamicResource FieldLabel}" Width="Auto" />
                    <TextBox x:Name="SrvKeysRefreshBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                             Style="{DynamicResource KaiTextBox}" LostFocus="SrvSettingsField_LostFocus" />
                  </Grid>
                  <CheckBox x:Name="SrvKeysBalloonCheck" Content="Info tip when VIN is read" Style="{DynamicResource KaiCheckBox}"
                            Margin="0,4,0,6" Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <CheckBox x:Name="SrvKeysVinBmwFailOnlyCheck" Content="and only when upload to BMW server fails" Style="{DynamicResource KaiCheckBox}"
                            Margin="18,0,0,6" Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <CheckBox x:Name="SrvKeysAutoCopyCheck" Content="Auto-copy VIN when read" Style="{DynamicResource KaiCheckBox}"
                            Margin="18,0,0,6" Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <StackPanel Orientation="Horizontal" Margin="18,0,0,8" VerticalAlignment="Center">
                    <TextBox x:Name="SrvKeysVinTipBox" Width="40" HorizontalAlignment="Left"
                             Style="{DynamicResource KaiTextBox}" Margin="0,0,8,0"
                             LostFocus="SrvSettingsField_LostFocus"
                             ToolTip="3–60 sec, or 0 = until Copy VIN / Close / next VIN tip" />
                    <TextBlock x:Name="SrvKeysVinTipLabel" Text="VIN tip duration (sec, 0 = sticky):" Style="{DynamicResource FieldLabel}"
                               Width="Auto" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock x:Name="SrvKeysStallLabel" Text="Stall alert after (minutes):" Style="{DynamicResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="SrvKeysStallBox" Width="60" HorizontalAlignment="Left"
                             Style="{DynamicResource KaiTextBox}" LostFocus="SrvSettingsField_LostFocus" />
                  </StackPanel>
                  <CheckBox x:Name="SrvKeysStallAlertCheck" Content="Alert tip when VIN is read but upload to BMW server fails" Style="{DynamicResource KaiCheckBox}"
                            Margin="0,0,0,8" Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <Button x:Name="SrvDownloadKeyDebugFolderBtn" Content="Download key debug folder" Style="{DynamicResource BeigeButton}"
                          HorizontalAlignment="Left" MinWidth="180" Margin="0,4,0,0"
                          Click="SrvDownloadKeyDebugFolder_Click" Tag="{DynamicResource IconFolder}"
                          Visibility="Collapsed" />
                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="SrvAuthGroup" Header="Auth" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <CheckBox x:Name="SrvBrowserPassHintCheck" Content="On auth failure, remind to match browser password"
                            Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                            Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <CheckBox x:Name="SrvUseSystemProxyCheck" Content="Use system proxy" Style="{DynamicResource KaiCheckBox}"
                            Margin="0,0,0,8" Checked="SrvSettings_Changed" Unchecked="SrvSettings_Changed" />
                  <StackPanel Grid.IsSharedSizeScope="True">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="AuthLabel" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="AosIntervalLabel" Style="{DynamicResource FieldLabel}" Text="Check health interval (hours):"
                                 Width="Auto" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="AosIntervalBox" Width="80" HorizontalAlignment="Left"
                                 Style="{DynamicResource KaiTextBox}" Text="1"
                                 TextChanged="AosField_TextChanged" LostFocus="AosField_LostFocus" />
                        <Button x:Name="AosStartTimerBtn" Content="Start timer" Style="{DynamicResource BeigeButton}"
                                MinWidth="110" Margin="12,0,8,0" Click="AosStartTimer_Click"  Tag="{DynamicResource IconPlay}" />
                        <Button x:Name="AosStopTimerBtn" Content="Stop timer" Style="{DynamicResource BeigeButton}"
                                MinWidth="110" Click="AosStopTimer_Click"  Tag="{DynamicResource IconStop}" />
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="AuthLabel" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="SrvAuthCooldownLabel" Text="Auth cooldown (minutes):" Style="{DynamicResource FieldLabel}"
                                 Width="Auto" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBox x:Name="SrvAuthCooldownBox" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                               Style="{DynamicResource KaiTextBox}" LostFocus="SrvSettingsField_LostFocus" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="AuthLabel" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="SrvAuthBlockAfterLabel" Text="Register blocked after (attempts):" Style="{DynamicResource FieldLabel}"
                                 Width="Auto" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBox x:Name="SrvAuthBlockAfterBox" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                               Style="{DynamicResource KaiTextBox}" LostFocus="SrvSettingsField_LostFocus" />
                    </Grid>
                  </StackPanel>
                  <Button x:Name="ForceRegisterBtn" Content="Force Register" Style="{DynamicResource BeigeButton}"
                          HorizontalAlignment="Left" MinWidth="140" Margin="0,0,0,10"
                          Click="ForceRegister_Click"
                          ToolTip="Always Register at Kai Zentral — ignores Health OK, auth cooldown, and Register-blocked"  Tag="{DynamicResource IconForce}" />
                  <Border x:Name="AuthGuardsStatusPanel" Background="{DynamicResource PanelMutedBgBrush}"
                          BorderBrush="{DynamicResource FieldBorderBrush}"
                          BorderThickness="1" CornerRadius="3" Padding="10,8">
                    <StackPanel>
                      <TextBlock x:Name="AuthGuardsStatusTitle" Text="Auth guards" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                      <DockPanel Margin="0,0,0,2" LastChildFill="True">
                        <Button x:Name="ClearAuthCooldownBtn" DockPanel.Dock="Right" Content="Clear"
                                Style="{DynamicResource BeigeButton}" MinWidth="64" Margin="8,0,0,0"
                                Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed"
                                Click="ClearAuthCooldown_Click"
                                ToolTip="Clear auth cooldown (set inactive)"  Tag="{DynamicResource IconClear}" />
                        <TextBlock x:Name="AuthCooldownStatusLine" TextWrapping="Wrap" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                      </DockPanel>
                      <TextBlock x:Name="AuthCooldownExplainText" TextWrapping="Wrap" FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" />
                      <DockPanel Margin="0,0,0,2" LastChildFill="True">
                        <Button x:Name="ClearAuthRegisterBlockedBtn" DockPanel.Dock="Right" Content="Clear"
                                Style="{DynamicResource BeigeButton}" MinWidth="64" Margin="8,0,0,0"
                                Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed"
                                Click="ClearAuthRegisterBlocked_Click"
                                ToolTip="Clear Register blocked (set inactive)"  Tag="{DynamicResource IconClear}" />
                        <TextBlock x:Name="AuthRegisterBlockedStatusLine" TextWrapping="Wrap" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                      </DockPanel>
                      <TextBlock x:Name="AuthRegisterBlockedExplainText" TextWrapping="Wrap" FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="SrvNotifyGroup" Header="Notify server" Style="{DynamicResource KaiGroupBox}">
                <StackPanel>
                  <CheckBox x:Name="SrvNotifyEnabledCheck" Content="Enable notify server (remote clients)"
                            Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8" IsEnabled="False" />
                  <StackPanel Grid.IsSharedSizeScope="True">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="NotifyLabel" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="SrvNotifyIpLabel" Text="This PC IP (enter in client):"
                                 Style="{DynamicResource FieldLabel}" Width="Auto" VerticalAlignment="Center"
                                 Margin="0,0,12,0" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SrvNotifyIpBox" Style="{DynamicResource KaiTextBox}"
                                 IsReadOnly="True" IsEnabled="False" TextWrapping="NoWrap" MinHeight="28"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button x:Name="SrvNotifyIpCopyBtn"
                                Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                                MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                                Content=""
                                Click="SrvNotifyIpCopy_Click"
                                ToolTip="Copy IP"
                                Tag="{DynamicResource IconCopy}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="NotifyLabel" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="SrvNotifyPortLabel" Text="Port:" Style="{DynamicResource FieldLabel}"
                                 Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SrvNotifyPortBox" Width="80" HorizontalAlignment="Left"
                                 Style="{DynamicResource KaiTextBox}" IsReadOnly="True" IsEnabled="False" />
                        <Button x:Name="SrvNotifyPortCopyBtn"
                                Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                                MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                                Content=""
                                Click="SrvNotifyPortCopy_Click"
                                ToolTip="Copy port"
                                Tag="{DynamicResource IconCopy}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                  <Grid Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SrvNotifySendToLabel" Text="Send test to:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox x:Name="SrvNotifySendToCombo" Grid.Column="1" Margin="0,0,8,0"
                              MinWidth="160" HorizontalAlignment="Left"
                              MinHeight="28" DisplayMemberPath="Label"
                              Style="{DynamicResource KaiComboBox}" />
                    <Button x:Name="SrvNotifyRefreshBtn" Grid.Column="2" Content="Refresh"
                            Style="{DynamicResource BeigeButton}" Padding="10,4" MinHeight="28"
                            Click="SrvNotifyRefresh_Click"  Tag="{DynamicResource IconRefresh}" />
                  </Grid>
                  <WrapPanel Margin="0,0,0,4">
                    <Button x:Name="SrvNotifyTestVinBtn" Content="Test VIN" Style="{DynamicResource BeigeButton}"
                            Margin="0,0,8,6" Padding="10,4" Click="SrvNotifyTestVin_Click"  Tag="{DynamicResource IconVin}" />
                    <Button x:Name="SrvNotifyTestInfoBtn" Content="Test Info" Style="{DynamicResource BeigeButton}"
                            Margin="0,0,8,6" Padding="10,4" Click="SrvNotifyTestInfo_Click"  Tag="{DynamicResource IconInfo}" />
                    <Button x:Name="SrvNotifyTestWarningBtn" Content="Test Warning" Style="{DynamicResource BeigeButton}"
                            Margin="0,0,8,6" Padding="10,4" Click="SrvNotifyTestWarning_Click"  Tag="{DynamicResource IconWarning}" />
                    <Button x:Name="SrvNotifyTestErrorBtn" Content="Test Error" Style="{DynamicResource BeigeButton}"
                            Margin="0,0,8,6" Padding="10,4" Click="SrvNotifyTestError_Click"  Tag="{DynamicResource IconError}" />
                    <Button x:Name="SrvUpdateAllClientsBtn" Content="Update all clients" Style="{DynamicResource BeigeButton}"
