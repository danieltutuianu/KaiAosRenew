<Window x:Class="KaiAosRenew.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAI - AOS Renew"
        Width="1280" Height="740"
        MinWidth="1180" MinHeight="600"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{DynamicResource KaiFont}"
        WindowStartupLocation="CenterScreen"
        FocusVisualStyle="{x:Null}"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Activated="Window_Activated">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border x:Name="HeaderBorder" Grid.Row="0" Background="{DynamicResource WindowBgBrush}" Padding="20,12,20,8">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HeaderTitleText" Grid.Column="0" Text="KAI - AOS Renew"
                   Style="{DynamicResource TitleText}" VerticalAlignment="Bottom" />
        <TextBlock x:Name="DebugModeText" Grid.Column="1" Text="" Margin="12,0,0,3" FontSize="13"
                   FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorBrush}"
                   Cursor="Hand" VerticalAlignment="Bottom" Visibility="Collapsed"
                   MouseLeftButtonDown="DebugModeText_MouseLeftButtonDown" />
      </Grid>
    </Border>

    <Grid x:Name="MainContentHost" Grid.Row="1" Margin="24,4,24,4"
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <TabControl x:Name="MainTabs" Background="{DynamicResource WindowBgBrush}"
                  BorderBrush="{DynamicResource FieldBorderBrush}"
                  VerticalContentAlignment="Stretch"
                  SelectionChanged="MainTabs_SelectionChanged">
      <TabItem x:Name="TabDummy" Visibility="Collapsed" Header="">
        <Border />
      </TabItem>
      <TabItem x:Name="TabKeys" IsSelected="True">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TabKeysHeaderText" Text="Keys" VerticalAlignment="Center" />
            <TextBlock x:Name="KeysTodayBadge" Text="" Margin="6,0,0,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <Ellipse x:Name="KeysTabAlertDot" Width="10" Height="10" Margin="8,0,0,0"
                     Fill="#FFE53935" VerticalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="12" VerticalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="KeysRefreshBtn" Content="Refresh" Style="{DynamicResource BeigeButton}"
                    Click="KeysRefresh_Click" MinWidth="90" Margin="0,0,8,0"  Tag="{DynamicResource IconRefresh}" />
            <Button x:Name="KeysClearBtn" Content="Clear" Style="{DynamicResource BeigeButton}"
                    Click="KeysClear_Click" MinWidth="80" Margin="0,0,8,0"  Tag="{DynamicResource IconClear}" />
            <Button x:Name="KeysRetryBmwBtn" Content="Retry BMW" Style="{DynamicResource BeigeButton}"
                    Click="KeysRetryBmw_Click" MinWidth="100" Margin="0,0,8,0"
                    IsEnabled="False"
                    ToolTip="Re-send last key file on disk (Transferred keyreader.bin) to BMW Server"  Tag="{DynamicResource IconRetry}" />
            <Button x:Name="KeysOpenUploaderLogBtn" Content="KeyUploader logs" Style="{DynamicResource BeigeButton}"
                    Click="KeysOpenUploaderLog_Click" MinWidth="120" Margin="0,0,8,0"  Tag="{DynamicResource IconLog}" />
            <Button x:Name="KeysOpenKaiLogBtn" Content="KAI logs" Style="{DynamicResource BeigeButton}"
                    Click="KeysOpenKaiLog_Click" MinWidth="90" Margin="0,0,8,0"  Tag="{DynamicResource IconLog}" />
            <TextBlock x:Name="KeysFilterLabel" Text="Filter:" VerticalAlignment="Center" Margin="8,0,6,0"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
            <ComboBox x:Name="KeysFilterCombo" Width="120" VerticalAlignment="Center"
                      Style="{DynamicResource KaiComboBox}"
                      SelectionChanged="KeysFilter_SelectionChanged" />
            <TextBlock x:Name="KeysSearchLabel" Text="Search:" VerticalAlignment="Center" Margin="10,0,6,0"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
            <TextBox x:Name="KeysSearchBox" Width="140" VerticalAlignment="Center"
                     Style="{DynamicResource KaiTextBox}"
                     ToolTip="VIN / paint / I-level"
                     TextChanged="KeysSearchBox_TextChanged" />
            <Button x:Name="KeysSearchClearBtn" Content="✕" Style="{DynamicResource BeigeButton}"
                    Click="KeysSearchClear_Click" MinWidth="28" Padding="8,4,8,4" Margin="6,0,0,0"
                    HorizontalContentAlignment="Center" Visibility="Collapsed"
                    ToolTip="Clear search" />
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border x:Name="KeysReaderWarnBanner" Background="{DynamicResource WarnBannerBgBrush}"
                    BorderBrush="{DynamicResource StatusWarnBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8"
                    Visibility="Collapsed">
              <TextBlock x:Name="KeysReaderWarnText" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="KeysReaderSection" Text="Reader:" Style="{DynamicResource SectionText}" Margin="0,0,0,4"
                       Visibility="Collapsed" />
            <TextBlock x:Name="KeysReaderSummaryText" Text="" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
            <TextBlock x:Name="KeysServicesText" Text="" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
            <TextBlock x:Name="KeysEventsSection" Text="Recent key activity:" Style="{DynamicResource SectionText}" Margin="0,0,0,4" />
            <TextBlock x:Name="KeysEmptyHint" Text="No key activity yet"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                       Margin="0,0,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="KeysNoMatchesHint" Text="No matches — clear filter"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                       Margin="0,0,0,0" Visibility="Collapsed" />
          </StackPanel>

          <ListView x:Name="KeysEventsList" Grid.Row="2"
                    BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource FieldBgBrush}"
                    FontFamily="{DynamicResource KaiFont}" FontSize="12"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="KeysEventsList_SelectionChanged"
                    PreviewMouseRightButtonDown="KeysEventsList_PreviewMouseRightButtonDown"
                    PreviewMouseRightButtonUp="KeysEventsList_PreviewMouseRightButtonUp"
                    PreviewKeyDown="KeysEventsList_PreviewKeyDown">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource KaiListViewItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="ToolTip" Value="{Binding RowToolTip}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="BmwOk">
                    <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="LocalOk">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn x:Name="KeysColTime" Header="Time" Width="120"
                                DisplayMemberBinding="{Binding TimeText}" />
                <GridViewColumn x:Name="KeysColVin" Header="VIN" Width="175">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Button Padding="0" Margin="0,0,4,0" Width="18" Height="18"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Content="&#xE8C8;"
                                Cursor="Hand" Focusable="False"
                                Background="Transparent" BorderThickness="0"
                                Loaded="KeysVinCopyIcon_Loaded"
                                DataContextChanged="KeysVinCopyIcon_DataContextChanged"
                                PreviewMouseLeftButtonDown="KeysVinCopyIcon_PreviewMouseLeftButtonDown"
                                Click="KeysVinCopyIcon_Click">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                  <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Button.ToolTip>
                            <ToolTip Foreground="Black" Background="#FFF7F7F7" BorderBrush="#FFABABAB" BorderThickness="1"
                                     Padding="6,4">
                              <TextBlock Text="Copy VIN" Foreground="Black" />
                            </ToolTip>
                          </Button.ToolTip>
                        </Button>
                        <TextBlock Tag="vin" VerticalAlignment="Center"
                                   Loaded="KeysHighlightCell_Loaded"
                                   DataContextChanged="KeysHighlightCell_DataContextChanged" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="KeysColKm" Header="Km" Width="95">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Button Padding="0" Margin="0,0,4,0" Width="18" Height="18"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Content="&#xE8C8;"
                                Cursor="Hand" Focusable="False"
                                Background="Transparent" BorderThickness="0"
                                Loaded="KeysKmCopyIcon_Loaded"
                                DataContextChanged="KeysKmCopyIcon_DataContextChanged"
                                PreviewMouseLeftButtonDown="KeysKmCopyIcon_PreviewMouseLeftButtonDown"
                                Click="KeysKmCopyIcon_Click">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                  <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <Button.ToolTip>
                            <ToolTip Foreground="Black" Background="#FFF7F7F7" BorderBrush="#FFABABAB" BorderThickness="1"
                                     Padding="6,4">
                              <TextBlock Text="Copy Km" Foreground="Black" />
                            </ToolTip>
                          </Button.ToolTip>
                        </Button>
                        <TextBlock Text="{Binding KmText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="KeysColPaint" Header="Color" Width="60"
                                DisplayMemberBinding="{Binding PaintText}" />
                <GridViewColumn x:Name="KeysColUpholstery" Header="Upholstery" Width="95"
                                DisplayMemberBinding="{Binding UpholsteryText}" />
                <GridViewColumn x:Name="KeysColILevel" Header="I-level" Width="130">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Tag="ilevel"
                                 Loaded="KeysHighlightCell_Loaded"
                                 DataContextChanged="KeysHighlightCell_DataContextChanged" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="KeysColReader" Header="Reader" Width="100"
                                DisplayMemberBinding="{Binding ReaderId}" />
                <GridViewColumn x:Name="KeysColLocal" Header="Local" Width="50"
                                DisplayMemberBinding="{Binding LocalText}" />
                <GridViewColumn x:Name="KeysColBmw" Header="BMW Server" Width="85"
                                DisplayMemberBinding="{Binding BmwText}" />
                <GridViewColumn x:Name="KeysColStatus" Header="Status" Width="75"
                                DisplayMemberBinding="{Binding StatusText}" />
                <GridViewColumn x:Name="KeysColDetail" Header="Detail" Width="220"
                                DisplayMemberBinding="{Binding DetailText}" />
                <GridViewColumn x:Name="KeysColBin" Header="Bin" Width="0">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Button x:Name="KeysOpenBinBtn"
                              Width="20" Height="20" Padding="3" Margin="0"
                              MinWidth="20" MinHeight="20"
                              Background="#FFEDE4D4" BorderBrush="#FF9A8F7C" BorderThickness="1"
                              HorizontalAlignment="Center"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              VerticalAlignment="Center" Cursor="Hand" Focusable="False"
                              Loaded="KeysOpenBinBtn_Loaded"
                              DataContextChanged="KeysOpenBinBtn_DataContextChanged"
                              Click="KeysOpenBinBtn_Click"
                              ToolTip="Open archived keyreader.bin">
                        <Viewbox Width="12" Height="12">
                          <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Data="{DynamicResource IconOpen}" Stretch="Uniform" />
                        </Viewbox>
                      </Button>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Name="KeysColBinPad" Header="" Width="0">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Border />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>

          <TextBlock x:Name="KeysHintText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"
                     Text="Place a key on the reader — activity is detected from KeyUploader / KAI logs (no raw key data shown)." />
        </Grid>
      </TabItem>
      <TabItem x:Name="TabRenew">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TabRenewHeaderText" Text="AOS access" VerticalAlignment="Center" />
            <Ellipse x:Name="RenewTabAlertDot" Width="10" Height="10" Margin="8,0,0,0"
                     Fill="#FFE53935" VerticalAlignment="Center" Visibility="Collapsed"
                     Cursor="Hand" MouseLeftButtonDown="RenewTabAlertDot_Click" />
          </StackPanel>
        </TabItem.Header>
        <Grid x:Name="FormGrid" Margin="12,12,12,8" Background="{DynamicResource WindowBgBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="24" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" HorizontalAlignment="Center" Width="500" MaxWidth="520" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Name="AosLoginStatusIcon" FontFamily="Segoe MDL2 Assets" FontSize="22"
                         VerticalAlignment="Center" Margin="0,0,10,0" Text="" />
              <TextBlock x:Name="AosLoginStatusText" Text="" FontSize="22" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="500" MaxWidth="520">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="AosUserLabel" Text="AOS username:" Style="{DynamicResource FieldLabel}" Width="Auto" />
              <TextBox x:Name="EmailBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                       TextChanged="AosEmail_TextChanged" />
            </Grid>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="AosPassLabel" Text="AOS password:" Style="{DynamicResource FieldLabel}" Width="Auto" />
              <Grid Grid.Column="1">
                <PasswordBox x:Name="PasswordBox" Style="{DynamicResource KaiPasswordBox}"
                             PasswordChanged="AosPassword_Changed" />
                <TextBox x:Name="PasswordPlainBox" Style="{DynamicResource KaiTextBox}" Visibility="Collapsed"
                         TextChanged="AosPasswordPlain_TextChanged" />
              </Grid>
            </Grid>

            <CheckBox x:Name="ShowPasswordCheck" Content="Show password" Style="{DynamicResource KaiCheckBox}"
                      Margin="130,0,0,8"
                      Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />

            <Border x:Name="ClipboardPassBanner" Background="{DynamicResource WarnBannerBgBrush}"
                    BorderBrush="{DynamicResource StatusWarnBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="130,0,0,8"
                    Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ClipboardPassHeaderText" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock x:Name="ClipboardPassCurrentText" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" Margin="0,0,0,2" />
                <TextBlock x:Name="ClipboardPassClipText" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ClipboardPassPasteSaveBtn" Content="Paste &amp; Save" Style="{DynamicResource BeigeButton}"
                          Click="ClipboardPassPasteSave_Click" MinWidth="100" Margin="0,0,8,0"  Tag="{DynamicResource IconPaste}" />
                  <Button x:Name="ClipboardPassDismissBtn" Content="Dismiss" Style="{DynamicResource BeigeButton}"
                          Click="ClipboardPassDismiss_Click" MinWidth="80"  Tag="{DynamicResource IconDismiss}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <Button x:Name="SaveAosBtn" Style="{DynamicResource BeigeButton}"
                        Click="Save_Click" MinWidth="90" HorizontalAlignment="Center" Padding="12,4">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                      <Path Fill="{DynamicResource TextPrimaryBrush}"
                            Data="{DynamicResource AosIconSaveGeometry}" />
                    </Viewbox>
                    <TextBlock x:Name="SaveAosBtnText" Text="Save" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                  <Ellipse x:Name="AosDirtyPendingMark" Width="10" Height="10" Margin="0,0,6,0"
                           Fill="#B26A00" VerticalAlignment="Center" Visibility="Collapsed" />
                  <TextBlock x:Name="AosDirtyStatus" Text="" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <Grid Margin="0,36,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="CheckBrowserPassBtn" Style="{DynamicResource BeigeButton}"
                        Click="CheckBrowserPass_Click" MinWidth="160" Margin="0,0,8,0" Padding="12,4">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                      <Path Fill="{DynamicResource TextPrimaryBrush}"
                            Data="{DynamicResource AosIconSearchGeometry}" />
                    </Viewbox>
                    <TextBlock x:Name="CheckBrowserPassBtnText" Text="Check browser password" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="OpenBmwSsoBtn" Style="{DynamicResource BeigeButton}"
                        Click="OpenBmwSso_Click" MinWidth="120" Padding="12,4">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                      <Path Fill="{DynamicResource TextPrimaryBrush}"
                            Data="{DynamicResource AosIconOpenGeometry}" />
                    </Viewbox>
                    <TextBlock x:Name="OpenBmwSsoBtnText" Text="Open BMW AOS" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border x:Name="BrowserPassNewerBanner" Background="{DynamicResource WarnBannerBgBrush}"
                    BorderBrush="{DynamicResource StatusWarnBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,4,0,8"
                    Visibility="Collapsed">
              <TextBlock x:Name="BrowserPassNewerText" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" />
            </Border>

            <Border x:Name="AuthCooldownBanner" Background="{DynamicResource WarnBannerBgBrush}"
                    BorderBrush="{DynamicResource StatusWarnBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8"
                    Visibility="Collapsed">
              <TextBlock x:Name="AuthCooldownText" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarnBannerFgBrush}" FontSize="12" />
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem x:Name="TabActivity">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TabActivityHeaderText" Text="Activity" VerticalAlignment="Center" />
            <Ellipse x:Name="ActivityTabAlertDot" Width="10" Height="10" Margin="8,0,0,0"
                     Fill="#FFE53935" VerticalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="12" VerticalAlignment="Stretch" Background="{DynamicResource WindowBgBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
            <TextBlock x:Name="ActivityLogLabel" Text="Activity log" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
              <TextBlock x:Name="ActivityFilterLabel" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
              <ComboBox x:Name="LogFilterCombo" Width="120" Margin="0,0,10,0" VerticalAlignment="Center"
                        Style="{DynamicResource KaiComboBox}"
                        DisplayMemberPath="Name" SelectedValuePath="Code"
                        SelectionChanged="LogFilter_SelectionChanged" />
              <TextBlock x:Name="ActivitySearchLabel" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
              <TextBox x:Name="ActivitySearchBox" Width="140" Margin="0,0,10,0" VerticalAlignment="Center"
                       Style="{DynamicResource KaiTextBox}"
                       ToolTip="Message text"
                       TextChanged="ActivitySearchBox_TextChanged" />
              <Button x:Name="CheckTokenBtn" Content="Check token" Style="{DynamicResource BeigeButton}"
                      Click="CheckToken_Click" Margin="0,0,8,0" MinWidth="110" Padding="10,2,12,2"  Tag="{DynamicResource IconCheck}" />
              <Button x:Name="SaveActivityLogBtn" Content="Save log" Style="{DynamicResource BeigeButton}"
                      Click="SaveActivityLog_Click" Margin="0,0,8,0" MinWidth="88" Padding="10,2,12,2"  Tag="{DynamicResource IconSave}" />
              <Button x:Name="ClearLogBtn" Content="Clear" Style="{DynamicResource BeigeButton}"
                      Click="ClearLog_Click" Margin="0" MinWidth="72" Padding="10,2,12,2"  Tag="{DynamicResource IconClear}" />
            </StackPanel>
          </DockPanel>
          <StackPanel Grid.Row="1">
            <TextBlock x:Name="ActivityEmptyHint" Text="No activity yet"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                       Margin="0,0,0,4" Visibility="Collapsed" />
            <TextBlock x:Name="ActivityNoMatchesHint" Text="No matches — clear filter"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                       Margin="0,0,0,4" Visibility="Collapsed" />
          </StackPanel>
          <ListView x:Name="ActivityList" Grid.Row="2"
                    BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource FieldBgBrush}"
                    FontFamily="{DynamicResource KaiFont}" FontSize="12"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    MouseDoubleClick="ActivityList_MouseDoubleClick"
                    PreviewKeyDown="ActivityList_PreviewKeyDown">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource KaiListViewItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding LevelText}" Value="success">
                    <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding LevelText}" Value="warning">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarnBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding LevelText}" Value="error">
                    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding LevelText}" Value="verbose">
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn x:Name="ActivityColTime" Header="Time" Width="120"
                                DisplayMemberBinding="{Binding TimeText}" />
                <GridViewColumn x:Name="ActivityColLevel" Header="Level" Width="70"
                                DisplayMemberBinding="{Binding LevelText}" />
                <GridViewColumn x:Name="ActivityColText" Header="Message" Width="900"
                                DisplayMemberBinding="{Binding Text}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <TabItem x:Name="TabRegister">
        <TabItem.Header>
          <TextBlock x:Name="TabRegisterHeaderText" Text="Register" VerticalAlignment="Center" />
        </TabItem.Header>
        <Grid Margin="12" VerticalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
            <TextBlock x:Name="RegisterHistoryLabel" Text="Register history" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
              <TextBlock x:Name="RegisterFilterLabel" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
              <ComboBox x:Name="RegisterFilterCombo" Width="120" Margin="0,0,10,0" VerticalAlignment="Center"
                        Style="{DynamicResource KaiComboBox}"
                        DisplayMemberPath="Name" SelectedValuePath="Code"
                        SelectionChanged="RegisterFilter_SelectionChanged" />
              <TextBlock x:Name="RegisterSearchLabel" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
              <TextBox x:Name="RegisterSearchBox" Width="140" Margin="0,0,10,0" VerticalAlignment="Center"
                       Style="{DynamicResource KaiTextBox}"
                       ToolTip="Message text"
                       TextChanged="RegisterSearchBox_TextChanged" />
              <Button x:Name="SaveRegisterLogBtn" Content="Save log" Style="{DynamicResource BeigeButton}"
                      Click="SaveRegisterLog_Click" Margin="0,0,8,0" MinWidth="88" Padding="10,2,12,2"  Tag="{DynamicResource IconSave}" />
              <Button x:Name="ClearRegisterLogBtn" Content="Clear" Style="{DynamicResource BeigeButton}"
                      Click="ClearRegisterLog_Click" Margin="0" MinWidth="72" Padding="10,2,12,2"  Tag="{DynamicResource IconClear}" />
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="RegisterNoMatchesHint" Grid.Row="1" Text="No matches — clear filter"
                     Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                     Margin="0,0,0,4" Visibility="Collapsed" />
          <ListView x:Name="RegisterHistoryList" Grid.Row="2"
                    BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource FieldBgBrush}"
                    FontFamily="{DynamicResource KaiFont}" FontSize="12"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    MouseDoubleClick="RegisterHistoryList_MouseDoubleClick"
                    PreviewKeyDown="RegisterHistoryList_PreviewKeyDown">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource KaiListViewItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="1">
                    <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="0">
                    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn x:Name="RegisterColTime" Header="Time" Width="140"
                                DisplayMemberBinding="{Binding TimeText}" />
                <GridViewColumn x:Name="RegisterColResult" Header="Result" Width="70"
                                DisplayMemberBinding="{Binding ResultText}" />
                <GridViewColumn x:Name="RegisterColAge" Header="Age" Width="110"
                                DisplayMemberBinding="{Binding AgeText}" />
                <GridViewColumn x:Name="RegisterColDetail" Header="Detail" Width="520"
                                DisplayMemberBinding="{Binding Text}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <TabItem x:Name="TabKai">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TabKaiHeaderText" Text="KAI" VerticalAlignment="Center" />
            <Ellipse x:Name="KaiTabAlertDot" Width="10" Height="10" Margin="8,0,0,0"
                     Fill="#FFE53935" VerticalAlignment="Center" Visibility="Collapsed"
                     Cursor="Hand" MouseLeftButtonDown="KaiTabAlertDot_Click" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="KaiRefreshBtn" Content="Refresh" Style="{DynamicResource BeigeButton}"
                      Click="KaiRefresh_Click" MinWidth="90"  Tag="{DynamicResource IconRefresh}" />
            </StackPanel>

            <TextBlock x:Name="KaiInstallSection" Text="Installation:" Style="{DynamicResource SectionText}" Margin="0,0,0,6" />
            <TextBlock x:Name="KaiInstallText" Text="—" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />

            <TextBlock x:Name="KaiUrlsSection" Text="Kai Zentral URLs:" Style="{DynamicResource SectionText}" Margin="0,0,0,6" />
            <TextBlock x:Name="KaiUrlRegisterLabel" Text="Register:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBox x:Name="KaiUrlRegisterBox" IsReadOnly="True" Style="{DynamicResource KaiTextBox}" Margin="0,2,0,6" TextWrapping="Wrap" />
            <TextBlock x:Name="KaiUrlWebEamLabel" Text="WebEAM:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBox x:Name="KaiUrlWebEamBox" IsReadOnly="True" Style="{DynamicResource KaiTextBox}" Margin="0,2,0,6" TextWrapping="Wrap" />
            <TextBlock x:Name="KaiUrlUploadLabel" Text="Key upload:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBox x:Name="KaiUrlUploadBox" IsReadOnly="True" Style="{DynamicResource KaiTextBox}" Margin="0,2,0,12" TextWrapping="Wrap" />

            <TextBlock x:Name="KaiTokenSection" Text="WebEAM token:" Style="{DynamicResource SectionText}" Margin="0,0,0,6" />
            <TextBlock x:Name="KaiTokenExpiryText" Text="—" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />

            <DockPanel Margin="0,0,0,6" LastChildFill="True">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="KaiFixServicesBtn" Content="Fix now" Style="{DynamicResource BeigeButton}"
                        Click="KaiFixServices_Click" MinWidth="90" Margin="0,0,8,0"
                        Visibility="Collapsed"  Tag="{DynamicResource IconFix}" />
                <Button x:Name="KaiStopServicesBtn" Content="Restart" Style="{DynamicResource BeigeButton}"
                        Click="KaiStopServices_Click" MinWidth="80"
                        Visibility="Collapsed"  Tag="{DynamicResource IconRestart}" />
              </StackPanel>
              <TextBlock x:Name="KaiServicesSection" Text="Services:" Style="{DynamicResource SectionText}"
                         Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <Grid x:Name="KaiServicesGrid" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="KaiSvcColName" Grid.Row="0" Grid.Column="0" Text="Service" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,4" />
              <TextBlock x:Name="KaiSvcColStatus" Grid.Row="0" Grid.Column="1" Text="Status" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,4" />
              <TextBlock x:Name="KaiSvcColStart" Grid.Row="0" Grid.Column="2" Text="Start type" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
              <TextBlock x:Name="KaiSvc1Name" Grid.Row="1" Grid.Column="0" Text="—" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,4" TextWrapping="Wrap" />
              <TextBlock x:Name="KaiSvc1Status" Grid.Row="1" Grid.Column="1" Text="—" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,4" />
              <TextBlock x:Name="KaiSvc1Start" Grid.Row="1" Grid.Column="2" Text="—" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
              <TextBlock x:Name="KaiSvc2Name" Grid.Row="2" Grid.Column="0" Text="—" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" TextWrapping="Wrap" />
              <TextBlock x:Name="KaiSvc2Status" Grid.Row="2" Grid.Column="1" Text="—" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
              <TextBlock x:Name="KaiSvc2Start" Grid.Row="2" Grid.Column="2" Text="—" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabSettings">
        <TabItem.Header>
          <TextBlock x:Name="TabSettingsHeaderText" Text="Settings" VerticalAlignment="Center" />
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="12" VerticalAlignment="Stretch">
          <StackPanel>
            <GroupBox x:Name="SettingsGeneralGroup" Header="General" Style="{DynamicResource KaiGroupBox}">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="LanguageLabel" Text="Language:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                            Style="{DynamicResource KaiComboBox}"
                            DisplayMemberPath="Name" SelectedValuePath="Code"
                            SelectionChanged="LanguageCombo_SelectionChanged"
                            ToolTip="UI language" />
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ThemeLabel" Text="Theme:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                            Style="{DynamicResource KaiComboBox}"
                            DisplayMemberPath="Name" SelectedValuePath="Code"
                            SelectionChanged="ThemeCombo_SelectionChanged"
                            ToolTip="Day / night / follow system" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Button x:Name="AboutOpenSettingsBtn" Content="Open settings folder" Style="{DynamicResource BeigeButton}"
                          HorizontalAlignment="Left" MinWidth="130" Margin="0,0,8,0"
                          Click="AboutOpenSettings_Click"  Tag="{DynamicResource IconFolder}" />
                  <Button x:Name="AboutOpenLogsBtn" Content="Open logs folder" Style="{DynamicResource BeigeButton}"
                          HorizontalAlignment="Left" MinWidth="130"
                          Click="AboutOpenLogs_Click"  Tag="{DynamicResource IconFolder}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ExportBtn" Content="Export settings" Style="{DynamicResource BeigeButton}"
                          Click="Export_Click" Margin="0,0,8,0" MinWidth="120"  Tag="{DynamicResource IconExport}" />
                  <Button x:Name="ImportBtn" Content="Import settings" Style="{DynamicResource BeigeButton}"
                          Click="Import_Click" MinWidth="120"  Tag="{DynamicResource IconImport}" />
                </StackPanel>
              </StackPanel>
            </GroupBox>

<GroupBox x:Name="SettingsStartupGroup" Header="Startup" Style="{DynamicResource KaiGroupBox}">
              <StackPanel>
                <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"
                          Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                          Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"
                          ToolTip="Launch KaiAosRenew when Windows starts" />
                <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to tray on Windows start"
                          Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                          Checked="MinimizeToTray_Changed" Unchecked="MinimizeToTray_Changed"
                          ToolTip="Only at Windows autostart: hide window to tray (requires Start with Windows)" />
                <CheckBox x:Name="MinimizeOnCloseCheck" Content="Yes (X hides to tray)"
                          Style="{DynamicResource KaiCheckBox}"
                          IsChecked="True" Margin="0,0,0,8"
                          Checked="MinimizeOnClose_Changed" Unchecked="MinimizeOnClose_Changed"
                          ToolTip="X / Alt+F4 hides to tray instead of quitting; Exit from tray still closes the app" />
                <CheckBox x:Name="AutoUpdateCheck" Content="Auto update"
                          Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                          IsChecked="True"
                          Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"
                          ToolTip="Download and install updates automatically, then restart" />
                <Button x:Name="CheckForUpdatesBtn"
                        Content="Check for updates" Style="{DynamicResource BeigeButton}"
                        HorizontalAlignment="Left" Padding="10,4" Click="CheckForUpdates_Click"  Tag="{DynamicResource IconUpdate}" />
              </StackPanel>
            </GroupBox>

<GroupBox x:Name="SettingsKeysGroup" Header="Keys" Style="{DynamicResource KaiGroupBox}">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeysRefreshSecondsLabel" Text="Refresh interval (sec):" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="KeysRefreshSecondsBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                           Style="{DynamicResource KaiTextBox}" Text="3"
                           PreviewTextInput="IntervalBox_PreviewTextInput"
                           LostFocus="KeysRefreshSeconds_LostFocus"
                           ToolTip="How often the Keys tab polls while it is open (1–60 sec)" />
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeysVinTipSecondsLabel" Text="VIN tip duration (sec):" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="KeysVinTipSecondsBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                           Style="{DynamicResource KaiTextBox}" Text="10"
                           PreviewTextInput="IntervalBox_PreviewTextInput"
                           LostFocus="KeysVinTipSeconds_LostFocus"
                           ToolTip="How long the in-app VIN tip stays visible (3–60 sec)" />
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeysStallMinutesLabel" Text="Stall alert after (minutes):" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="KeysStallMinutesBox" Grid.Column="1" Width="60" HorizontalAlignment="Left"
                           Style="{DynamicResource KaiTextBox}" Text="2"
                           PreviewTextInput="IntervalBox_PreviewTextInput"
                           LostFocus="KeysStallMinutes_LostFocus"
                           ToolTip="Alert when Local OK but BMW Server upload stalls (1–60 min)" />
                </Grid>
                <CheckBox x:Name="KeysBalloonCheck" Content="Info tip when VIN is read (Copy)" Style="{DynamicResource KaiCheckBox}"
                          Margin="0,4,0,6" Checked="KeysOptions_Changed" Unchecked="KeysOptions_Changed"
                          ToolTip="Show in-app tip with Copy when a new VIN is read; double-click opens Keys" />
                <CheckBox x:Name="KeysVinBmwFailOnlyCheck"
                          Content="Info tip only when VIN is read and upload to BMW server fails"
                          Style="{DynamicResource KaiCheckBox}"
                          Margin="18,0,0,6" Checked="KeysOptions_Changed" Unchecked="KeysOptions_Changed"
                          ToolTip="Requires VIN tip above; suppress tip on every read and show only after BMW upload fails" />
                <CheckBox x:Name="KeysAutoCopyVinCheck" Content="Auto-copy VIN when read" Style="{DynamicResource KaiCheckBox}"
                          Margin="0,0,0,6" Checked="KeysOptions_Changed" Unchecked="KeysOptions_Changed"
                          ToolTip="Copy VIN to clipboard automatically on each new read" />
                <CheckBox x:Name="KeysStallAlertCheck" Content="Alert if Local OK but BMW Server not uploaded"
                          Style="{DynamicResource KaiCheckBox}"
                          Margin="0,0,0,8" Checked="KeysOptions_Changed" Unchecked="KeysOptions_Changed"
                          ToolTip="Warn when a key stays Local OK without BMW Server upload past the stall time" />
                <Button x:Name="TestBalloonTipsBtn" Content="Test balloon tips" Style="{DynamicResource BeigeButton}"
                        HorizontalAlignment="Left" MinWidth="140" Margin="0,4,0,0"
                        Click="TestBalloonTipsBtn_Click"
                        ToolTip="Show sample info/warning/error balloon tips"  Tag="{DynamicResource IconInfo}" />
                <Button x:Name="KeysOpenDebugFolderBtn" Content="Open key debug folder" Style="{DynamicResource BeigeButton}"
                        HorizontalAlignment="Left" MinWidth="160" Margin="0,8,0,0"
                        Click="KeysOpenDebugFolder_Click"
                        ToolTip="Open %AppData%\\KaiAosRenew (key-bins and key-reader-parse.log)"
                        Tag="{DynamicResource IconFolder}" />
              </StackPanel>
            </GroupBox>

<GroupBox x:Name="SettingsAuthGroup" Header="Auth" Style="{DynamicResource KaiGroupBox}">
              <StackPanel>
                <CheckBox x:Name="BrowserPassHintCheck" Content="On auth failure, remind to match browser password"
                          Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                          Checked="BrowserPassHint_Changed" Unchecked="BrowserPassHint_Changed"
                          ToolTip="Hint when Register fails so you can align the app password with Chrome/Edge" />
                <CheckBox x:Name="UseSystemProxyCheck" Content="Use system proxy" Style="{DynamicResource KaiCheckBox}"
                          Margin="0,0,0,8"
                          Checked="UseSystemProxy_Changed" Unchecked="UseSystemProxy_Changed"
                          ToolTip="Use Windows system proxy for Register / WebEAM requests" />
                <StackPanel Grid.IsSharedSizeScope="True" Margin="0,0,0,0">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="AuthLabel" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IntervalLabel" Text="Check health interval:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBox x:Name="IntervalBox" Style="{DynamicResource KaiTextBox}"
                               Width="80" HorizontalAlignment="Left" Text="1"
                               PreviewTextInput="IntervalBox_PreviewTextInput"
                               DataObject.Pasting="IntervalBox_Pasting"
                               TextChanged="IntervalBox_TextChanged"
                               LostFocus="IntervalBox_LostFocus"
                               KeyDown="IntervalBox_KeyDown" />
                      <Button x:Name="StartTimerBtn" Content="Start timer" Style="{DynamicResource BeigeButton}"
                              Click="StartTimer_Click" MinWidth="110" Margin="12,0,8,0"  Tag="{DynamicResource IconPlay}" />
                      <Button x:Name="StopTimerBtn" Content="Stop timer" Style="{DynamicResource BeigeButton}"
                              Click="StopTimer_Click" MinWidth="110"  Tag="{DynamicResource IconStop}" />
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="AuthLabel" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AuthCooldownMinutesLabel" Text="Auth cooldown (minutes):" Style="{DynamicResource FieldLabel}"
                               Width="Auto" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="AuthCooldownMinutesBox" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                             Style="{DynamicResource KaiTextBox}" Text="60"
                             PreviewTextInput="IntervalBox_PreviewTextInput"
                             DataObject.Pasting="IntervalBox_Pasting"
                             LostFocus="AuthCooldownMinutes_LostFocus"
                             ToolTip="After a hard 401, block Register for this many minutes (5–240)" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="AuthLabel" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AuthRegisterBlockAfterLabel" Text="Register blocked after (attempts):" Style="{DynamicResource FieldLabel}"
                               Width="Auto" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="AuthRegisterBlockAfterBox" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                             Style="{DynamicResource KaiTextBox}" Text="3"
                             PreviewTextInput="IntervalBox_PreviewTextInput"
                             DataObject.Pasting="IntervalBox_Pasting"
                             LostFocus="AuthRegisterBlockAfter_LostFocus"
                             ToolTip="Auto Register / failed Register activates Register blocked after this many attempts (1–10)" />
                  </Grid>
                </StackPanel>
                <Button x:Name="ForceRegisterBtn" Content="Force Register" Style="{DynamicResource BeigeButton}"
                        HorizontalAlignment="Left" MinWidth="140" Margin="0,0,0,10"
                        Click="ForceRegister_Click"
                        ToolTip="Always Register at Kai Zentral — ignores Health OK, auth cooldown, and Register-blocked"  Tag="{DynamicResource IconForce}" />
                <Border x:Name="AuthGuardsStatusPanel" Background="{DynamicResource PanelMutedBgBrush}"
                        BorderBrush="{DynamicResource FieldBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10,8">
                  <StackPanel>
                    <TextBlock x:Name="AuthGuardsStatusTitle" Text="Auth guards" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,2" LastChildFill="True">
                      <Button x:Name="ClearAuthCooldownBtn" DockPanel.Dock="Right" Content="Clear"
                              Style="{DynamicResource BeigeButton}" MinWidth="64" Margin="8,0,0,0"
                              Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed"
                              Click="ClearAuthCooldown_Click"
                              ToolTip="Clear auth cooldown (set inactive)"  Tag="{DynamicResource IconClear}" />
                      <TextBlock x:Name="AuthCooldownStatusLine" TextWrapping="Wrap" FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                    <TextBlock x:Name="AuthCooldownExplainText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,8" />
                    <DockPanel Margin="0,0,0,2" LastChildFill="True">
                      <Button x:Name="ClearAuthRegisterBlockedBtn" DockPanel.Dock="Right" Content="Clear"
                              Style="{DynamicResource BeigeButton}" MinWidth="64" Margin="8,0,0,0"
                              Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed"
                              Click="ClearAuthRegisterBlocked_Click"
                              ToolTip="Clear Register blocked (set inactive)"  Tag="{DynamicResource IconClear}" />
                      <TextBlock x:Name="AuthRegisterBlockedStatusLine" TextWrapping="Wrap" FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                    <TextBlock x:Name="AuthRegisterBlockedExplainText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </GroupBox>

<GroupBox x:Name="SettingsNotifyGroup" Header="Notify server" Style="{DynamicResource KaiGroupBox}">
              <StackPanel>
                <CheckBox x:Name="NotifyServerEnableCheck" Content="Enable notify server (remote clients)"
                          Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                          Checked="NotifyServer_Changed" Unchecked="NotifyServer_Changed"
                          ToolTip="Listen for KaiAosNotifyClient connections and forward all tips" />
                <StackPanel Grid.IsSharedSizeScope="True">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="NotifyLabel" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NotifyServerIpLabel" Text="This PC IP (enter in client):"
