                               ToolTip="Local IPv4 addresses — use one of these in KaiAosNotifyClient" />
                      <Button x:Name="NotifyServerIpCopyBtn"
                              Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                              MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                              Content=""
                              Click="NotifyServerIpCopy_Click"
                              ToolTip="Copy IP for client Host"  Tag="{DynamicResource IconCopy}" />
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="NotifyLabel" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NotifyServerPortLabel" Text="Port:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="NotifyServerPortBox" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                             Style="{DynamicResource KaiTextBox}" Text="17890"
                             PreviewTextInput="IntervalBox_PreviewTextInput"
                             LostFocus="NotifyServerPort_LostFocus"
                             ToolTip="TCP port for remote notify clients (1024–65535)" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="NotifyLabel" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NotifyPairingCodeLabel" Text="Pairing code:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0"
                               ToolTip="Optional. When set, clients must enter the same code to connect." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBox x:Name="NotifyPairingCodeBox" Width="140" HorizontalAlignment="Left"
                               Style="{DynamicResource KaiTextBox}"
                               LostFocus="NotifyPairingCode_LostFocus"
                               ToolTip="Leave empty to allow any LAN client (compat). Generate a code for workshops." />
                      <Button x:Name="NotifyPairingGenerateBtn"
                              Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                              MinWidth="80" Padding="8,2" VerticalAlignment="Center"
                              Content="Generate"
                              Click="NotifyPairingGenerate_Click"
                              ToolTip="Generate a new random pairing code" />
                      <Button x:Name="NotifyPairingCopyBtn"
                              Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                              MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                              Content=""
                              Click="NotifyPairingCopy_Click"
                              ToolTip="Copy pairing code"
                              Tag="{DynamicResource IconCopy}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <Grid Margin="0,10,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="NotifySendToLabel" Text="Send test to:" Style="{DynamicResource FieldLabel}"
                             Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <ComboBox x:Name="NotifySendToCombo" Grid.Column="1" Margin="0,0,8,0"
                            MinWidth="160" HorizontalAlignment="Left"
                            MinHeight="28" DisplayMemberPath="Label"
                            ToolTip="All connected clients, or one remote client" />
                  <Button x:Name="NotifyRefreshClientsBtn" Grid.Column="2" Content="Refresh"
                          Style="{DynamicResource BeigeButton}" Padding="10,4" MinHeight="28"
                          Click="NotifyRefreshClients_Click"
                          ToolTip="Refresh connected notify clients"  Tag="{DynamicResource IconRefresh}" />
                </Grid>
                <WrapPanel Margin="0,0,0,4">
                  <Button x:Name="NotifyTestVinBtn" Content="Test VIN" Style="{DynamicResource BeigeButton}"
                          Margin="0,0,8,6" Padding="10,4" Click="NotifyTestVin_Click"
                          ToolTip="Send a demo VIN tip to selected clients (TCP only)"  Tag="{DynamicResource IconVin}" />
                  <Button x:Name="NotifyTestInfoBtn" Content="Test Info" Style="{DynamicResource BeigeButton}"
                          Margin="0,0,8,6" Padding="10,4" Click="NotifyTestInfo_Click"
                          ToolTip="Send an info tip to selected clients (TCP only)"  Tag="{DynamicResource IconInfo}" />
                  <Button x:Name="NotifyTestWarningBtn" Content="Test Warning" Style="{DynamicResource BeigeButton}"
                          Margin="0,0,8,6" Padding="10,4" Click="NotifyTestWarning_Click"
                          ToolTip="Send a warning tip to selected clients (TCP only)"  Tag="{DynamicResource IconWarning}" />
                  <Button x:Name="NotifyTestErrorBtn" Content="Test Error" Style="{DynamicResource BeigeButton}"
                          Margin="0,0,8,6" Padding="10,4" Click="NotifyTestError_Click"
                          ToolTip="Send an error tip to selected clients (TCP only)"  Tag="{DynamicResource IconError}" />
                  <Button x:Name="UpdateAllClientsBtn" Content="Update all clients" Style="{DynamicResource BeigeButton}"
                          Margin="0,0,8,6" Padding="10,4" Click="UpdateAllClients_Click"
                          ToolTip="Tell all connected clients to install the latest client version"
                          Tag="{DynamicResource IconUpdate}" />
                </WrapPanel>
                <TextBlock x:Name="NotifyTestResultText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
                <StackPanel x:Name="NotifyFirewallPanel" Orientation="Vertical" Margin="0,4,0,0"
                            Visibility="Collapsed">
                  <TextBlock x:Name="NotifyFirewallHintText" TextWrapping="Wrap"
                             Foreground="#8A5A00"
                             Text="If clients cannot connect, allow this TCP port in Windows Firewall (inbound)." />
                  <Button x:Name="NotifyFirewallAllowBtn" Content="Allow in Windows Firewall"
                          Style="{DynamicResource BeigeButton}" Margin="0,6,0,0"
                          HorizontalAlignment="Left" Padding="10,4" MinHeight="28"
                          Click="NotifyFirewallAllow_Click"
                          ToolTip="Add inbound TCP/UDP firewall rules for the notify port (UAC)"
                          Tag="{DynamicResource IconFix}" />
                </StackPanel>
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="SettingsPeerSyncGroup" Header="Peer sync (multi-site)" Style="{DynamicResource KaiGroupBox}">
              <StackPanel>
                <CheckBox x:Name="PeerSyncEnableCheck" Content="Enable peer sync (Google Apps Script)"
                          Style="{DynamicResource KaiCheckBox}" Margin="0,0,0,8"
                          Checked="PeerSync_Changed" Unchecked="PeerSync_Changed"
                          ToolTip="Sync AOS email/password with other KaiAosRenew servers via Google Apps Script" />
                <StackPanel Grid.IsSharedSizeScope="True">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="PeerLabel" Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PeerSyncUrlLabel" Text="Web App URL:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="PeerSyncUrlBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                             LostFocus="PeerSyncField_LostFocus"
                             ToolTip="Google Apps Script Web App URL ending with /exec" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="PeerLabel" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PeerSyncSecretLabel" Text="Shared secret:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0"
                               ToolTip="Same secret on every server. Used for AES encryption and relay auth." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBox x:Name="PeerSyncSecretBox" Width="220" HorizontalAlignment="Left"
                               Style="{DynamicResource KaiTextBox}"
                               LostFocus="PeerSyncField_LostFocus"
                               ToolTip="Same secret on every server. Used for AES encryption and relay auth." />
                      <Button x:Name="PeerSyncGenerateBtn"
                              Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                              MinWidth="80" Padding="8,2" VerticalAlignment="Center"
                              Content="Generate"
                              Click="PeerSyncGenerate_Click"
                              ToolTip="Generate a new shared secret" />
                      <Button x:Name="PeerSyncCopyBtn"
                              Style="{DynamicResource BeigeButton}" Margin="8,0,0,0"
                              MinWidth="36" Padding="8,2" VerticalAlignment="Center"
                              Content=""
                              Click="PeerSyncCopy_Click"
                              ToolTip="Copy shared secret"
                              Tag="{DynamicResource IconCopy}" />
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="PeerLabel" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PeerSyncServerNameLabel" Text="This server name:" Style="{DynamicResource FieldLabel}"
                               Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="PeerSyncServerNameBox" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                             Style="{DynamicResource KaiTextBox}"
                             LostFocus="PeerSyncField_LostFocus" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="PeerLabel" Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PeerSyncPollLabel" Text="Poll interval (minutes):" Style="{DynamicResource FieldLabel}"
                               Width="Auto" VerticalAlignment="Center" Margin="0,0,12,0"
                               ToolTip="How often to check the relay for credential updates (default 60 = 1 hour)." />
                    <TextBox x:Name="PeerSyncPollBox" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                             Style="{DynamicResource KaiTextBox}" Text="60"
                             PreviewTextInput="IntervalBox_PreviewTextInput"
                             LostFocus="PeerSyncField_LostFocus"
                             ToolTip="How often to check the relay for credential updates (default 60 = 1 hour)." />
                  </Grid>
                </StackPanel>
                <WrapPanel Margin="0,4,0,4">
                  <Button x:Name="PeerSyncNowBtn" Content="Sync now" Style="{DynamicResource BeigeButton}"
                          Margin="0,0,8,6" Padding="10,4" Click="PeerSyncNow_Click"
                          ToolTip="Poll the relay immediately" Tag="{DynamicResource IconRefresh}" />
                  <Button x:Name="PeerSyncPushBtn" Content="Push now" Style="{DynamicResource BeigeButton}"
                          Margin="0,0,8,6" Padding="10,4" Click="PeerSyncPush_Click"
                          ToolTip="Publish current AOS credentials without changing the password"
                          Tag="{DynamicResource IconUpdate}" />
                  <Button x:Name="PeerSyncUpdateAllBtn" Content="Update all peers" Style="{DynamicResource BeigeButton}"
                          Margin="0,0,8,6" Padding="10,4" Click="PeerSyncUpdateAll_Click"
                          ToolTip="Tell other sites to install the latest server update"
                          Tag="{DynamicResource IconUpdate}" />
                  <Button x:Name="PeerSyncTestBtn" Content="Test connection" Style="{DynamicResource BeigeButton}"
                          Margin="0,0,8,6" Padding="10,4" Click="PeerSyncTest_Click"
                          ToolTip="Ping the Google Apps Script relay" Tag="{DynamicResource IconInfo}" />
                </WrapPanel>
                <TextBlock x:Name="PeerSyncStatusText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextMutedBrush}" Text="" />
                <TextBlock x:Name="PeerSyncPeersLabel" Text="Peer servers:" Style="{DynamicResource SectionText}"
                           Margin="0,8,0,6" />
                <ListView x:Name="PeerSyncPeersList" Height="120" Margin="0,0,0,4">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn x:Name="PeerSyncColServer" Header="Server" Width="120"
                                      DisplayMemberBinding="{Binding ServerName}" />
                      <GridViewColumn x:Name="PeerSyncColHealth" Header="Status" Width="70"
                                      DisplayMemberBinding="{Binding Health}" />
                      <GridViewColumn x:Name="PeerSyncColToken" Header="Token" Width="70"
                                      DisplayMemberBinding="{Binding TokenStatus}" />
                      <GridViewColumn x:Name="PeerSyncColVersion" Header="Version" Width="70"
                                      DisplayMemberBinding="{Binding AppVersion}" />
                      <GridViewColumn x:Name="PeerSyncColClients" Header="Clients" Width="55"
                                      DisplayMemberBinding="{Binding ClientCount}" />
                      <GridViewColumn x:Name="PeerSyncColSeen" Header="Last seen" Width="120"
                                      DisplayMemberBinding="{Binding LastSeen}" />
                    </GridView>
                  </ListView.View>
                </ListView>
                <TextBlock x:Name="PeerSyncPeersEmptyHint" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Text="" Visibility="Collapsed" />
              </StackPanel>
            </GroupBox>

            <GroupBox x:Name="SettingsPathsGroup" Header="Paths" Style="{DynamicResource KaiGroupBox}">
              <StackPanel>
                <TextBlock x:Name="SectionConfigText" Text="KAI configuration:" Style="{DynamicResource SectionText}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ConfigPathLabel" Text="Config path:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="ConfigPathBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                           LostFocus="ConfigPath_LostFocus" Margin="0,0,8,0"
                           ToolTip="Folder with KAI_Properties.cfg" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BrowseBtn" Content="Browse..." Style="{DynamicResource BeigeButton}"
                            Click="Browse_Click" Margin="0,0,8,0" MinWidth="80" Tag="{DynamicResource IconBrowse}" />
                    <Button x:Name="ConfigPathOpenBtn" Content="Open" Style="{DynamicResource BeigeButton}"
                            Click="ConfigPathOpen_Click" Margin="0" MinWidth="72"
                            ToolTip="Open in Explorer" Tag="{DynamicResource IconOpen}" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="SettingsKeyReaderSection" Text="Desktop KeyReader Plus:" Style="{DynamicResource SectionText}" Margin="0,12,0,8" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeyReaderDataBinLabel" Text="DataBin:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="KeyReaderDataBinBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                           Margin="0,0,8,0" LostFocus="KeyReaderPaths_LostFocus"
                           ToolTip="keyreader.bin path (registry Data_Bin)" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="KeyReaderDataBinBrowseBtn" Content="Browse..." Style="{DynamicResource BeigeButton}"
                            Click="KeyReaderDataBinBrowse_Click" Margin="0,0,8,0" MinWidth="80" Tag="{DynamicResource IconBrowse}" />
                    <Button x:Name="KeyReaderDataBinOpenBtn" Content="Open" Style="{DynamicResource BeigeButton}"
                            Click="KeyReaderDataBinOpen_Click" Margin="0" MinWidth="72"
                            ToolTip="Open in Explorer" Tag="{DynamicResource IconOpen}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeyReaderLogPathLabel" Text="Log files location:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="KeyReaderLogPathBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                           Margin="0,0,8,0" LostFocus="KeyReaderPaths_LostFocus"
                           ToolTip="KeyReader Plus log folder (registry LogPath)" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="KeyReaderLogPathBrowseBtn" Content="Browse..." Style="{DynamicResource BeigeButton}"
                            Click="KeyReaderLogPathBrowse_Click" Margin="0,0,8,0" MinWidth="80" Tag="{DynamicResource IconBrowse}" />
                    <Button x:Name="KeyReaderLogPathOpenBtn" Content="Open" Style="{DynamicResource BeigeButton}"
                            Click="KeyReaderLogPathOpen_Click" Margin="0" MinWidth="72"
                            ToolTip="Open in Explorer" Tag="{DynamicResource IconOpen}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeyReaderEncPathLabel" Text="ENC file location:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="KeyReaderEncPathBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                           Margin="0,0,8,0" LostFocus="KeyReaderPaths_LostFocus"
                           ToolTip="BMWKeyReader.enc path (registry PathToENCFile)" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="KeyReaderEncPathBrowseBtn" Content="Browse..." Style="{DynamicResource BeigeButton}"
                            Click="KeyReaderEncPathBrowse_Click" Margin="0,0,8,0" MinWidth="80" Tag="{DynamicResource IconBrowse}" />
                    <Button x:Name="KeyReaderEncPathOpenBtn" Content="Open" Style="{DynamicResource BeigeButton}"
                            Click="KeyReaderEncPathOpen_Click" Margin="0" MinWidth="72"
                            ToolTip="Open in Explorer" Tag="{DynamicResource IconOpen}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeyReaderLogLevelLabel" Text="Logging:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <ComboBox x:Name="KeyReaderLogLevelCombo" Grid.Column="1" HorizontalAlignment="Left" Width="180"
                            FontFamily="{DynamicResource KaiFont}" FontSize="12"
                            DisplayMemberPath="Name" SelectedValuePath="Code"
                            SelectionChanged="KeyReaderLogLevel_SelectionChanged"
                            ToolTip="KeyReader Plus LogLevel 0–4 in registry" />
                </Grid>

                <TextBlock x:Name="SettingsKaiDataSection" Text="KAI data paths:" Style="{DynamicResource SectionText}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeysUploaderLogDirLabel" Text="KeyUploader logs:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="KeysUploaderLogDirBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                           Margin="0,0,8,0" LostFocus="KeysDataPaths_LostFocus"
                           ToolTip="Folder scanned for KeyUploader activity logs" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="KeysUploaderLogDirBrowseBtn" Content="Browse..." Style="{DynamicResource BeigeButton}"
                            Click="KeysUploaderLogDirBrowse_Click" Margin="0,0,8,0" MinWidth="80" Tag="{DynamicResource IconBrowse}" />
                    <Button x:Name="KeysUploaderLogDirOpenBtn" Content="Open" Style="{DynamicResource BeigeButton}"
                            Click="KeysUploaderLogDirOpen_Click" Margin="0" MinWidth="72"
                            ToolTip="Open in Explorer" Tag="{DynamicResource IconOpen}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeysKaiLogDirLabel" Text="KAI logs:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="KeysKaiLogDirBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                           Margin="0,0,8,0" LostFocus="KeysDataPaths_LostFocus"
                           ToolTip="Folder scanned for KAI service logs" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="KeysKaiLogDirBrowseBtn" Content="Browse..." Style="{DynamicResource BeigeButton}"
                            Click="KeysKaiLogDirBrowse_Click" Margin="0,0,8,0" MinWidth="80" Tag="{DynamicResource IconBrowse}" />
                    <Button x:Name="KeysKaiLogDirOpenBtn" Content="Open" Style="{DynamicResource BeigeButton}"
                            Click="KeysKaiLogDirOpen_Click" Margin="0" MinWidth="72"
                            ToolTip="Open in Explorer" Tag="{DynamicResource IconOpen}" />
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeysSqlitePathLabel" Text="SqliteKaiDb:" Style="{DynamicResource FieldLabel}" Width="Auto" />
                  <TextBox x:Name="KeysSqlitePathBox" Grid.Column="1" Style="{DynamicResource KaiTextBox}"
                           Margin="0,0,8,0" LostFocus="KeysDataPaths_LostFocus"
                           ToolTip="SqliteKaiDb.db used for VIN / reader metadata" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="KeysSqlitePathBrowseBtn" Content="Browse..." Style="{DynamicResource BeigeButton}"
                            Click="KeysSqlitePathBrowse_Click" Margin="0,0,8,0" MinWidth="80" Tag="{DynamicResource IconBrowse}" />
                    <Button x:Name="KeysSqlitePathOpenBtn" Content="Open" Style="{DynamicResource BeigeButton}"
                            Click="KeysSqlitePathOpen_Click" Margin="0" MinWidth="72"
                            ToolTip="Open in Explorer" Tag="{DynamicResource IconOpen}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      </TabControl>

      <Border x:Name="AboutPanel" Visibility="Collapsed" Background="{DynamicResource WindowBgBrush}"
              BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Margin="0,30,0,0"
              Panel.ZIndex="1">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="AboutTitleText" Text="KAI - AOS Renew" Style="{DynamicResource SectionText}" Margin="0,0,0,4" />
            <TextBlock x:Name="AboutVersionText" Text="" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"
                       Cursor="Hand" MouseLeftButtonDown="AboutVersionText_MouseLeftButtonDown" />
            <TextBlock x:Name="AboutChangelogLabel" Text="CHANGELOG.md" Style="{DynamicResource SectionText}" Margin="0,8,0,6" />
          </StackPanel>
          <TextBox x:Name="AboutChangelogBox" Grid.Row="1"
                   IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"
                   Style="{DynamicResource KaiTextBox}"
                   VerticalAlignment="Stretch" MinHeight="280" />
        </Grid>
      </Border>

      <Button x:Name="AboutTabBtn" Content="About" Style="{DynamicResource AboutTabButton}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,2,0,0" MinWidth="72" Panel.ZIndex="2"
              Click="AboutTabBtn_Click"  />
    </Grid>

    <Border x:Name="ButtonsBorder" Grid.Row="2" Background="{DynamicResource WindowBgBrush}" Padding="0"
            Visibility="Collapsed" Height="0" />

    <Border Grid.Row="3" Background="{DynamicResource FooterBgBrush}" Height="46" Padding="14,2,14,2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="22" />
          <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource StatusStoppedBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="StatusText" Text="Stopped" VerticalAlignment="Center"
                     FontSize="11" Foreground="{DynamicResource StatusStoppedBrush}" Margin="0,0,12,0" />
          <TextBlock x:Name="NextRunText" VerticalAlignment="Center"
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="TokenAgeText" Text=""
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,16,0" />
          <TextBlock x:Name="TokenFooterText" Text=""
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock x:Name="ServicesFooterText" Text=""
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
          <TextBlock x:Name="RegisterAgeText"
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Left" Text="" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="VersionText" Text="Server version: 1.0"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="UpdateAvailableText" Text=""
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
            <ProgressBar x:Name="UpdateProgressBar" Width="110" Height="10" Minimum="0" Maximum="100"
                         VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
            <Button x:Name="FooterUpdateBtn" Content="Update" Style="{DynamicResource FooterUpdateButton}"
                    VerticalAlignment="Center" Visibility="Collapsed" Click="FooterUpdate_Click"  Tag="{DynamicResource IconUpdate}" />
          </StackPanel>
          <TextBlock x:Name="AuthGuardsFooterText"
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Right" Text=""
                     TextTrimming="CharacterEllipsis" MaxWidth="420" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
