                               Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBox x:Name="NotifyServerIpBox" Style="{DynamicResource KaiTextBox}"
